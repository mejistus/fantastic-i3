#!/bin/bash
# 窗口切换器（yabai 版）
#   window_switcher --list   立刻弹出所有桌面的窗口列表
#   window_switcher --back   直接切到上一个用过的窗口（back-and-forth）
#   window_switcher [--auto] 快速按一下 = --back，按住 ⌘ 超过 HOLD_SECONDS = --list（⌘⇥）
#
# 列表：带应用图标，按桌面编号排序，上一个用过的窗口已选中；末尾是 Dock 里亮着点、但没有窗口的应用，
#       选中它就像点 Dock 图标（一般会新开一个窗口）。弹出时切到系统的英文输入法，
#       打字模糊搜索（输入桌面编号也行），↑↓ 或 ⌘⇥ / ⌘⇧⇥ 选择，回车或单击切换，Esc 关闭，
#       ⌘+ / ⌘- 调字号（会记住），⌘0 恢复默认
# 窗口使用顺序由 yabai 的 window_focused 信号记录（aero mru-push）；列表界面是 aero-helper switcher。
# 绑定：skhdrc 中的 cmd - tab

HOLD_SECONDS=0.25
FONT_SIZE=28      # 默认字号（用 ⌘+ / ⌘- 调过之后以调过的为准）
WIDTH=55          # 列表宽度（屏幕宽度的百分比）
ROWS=12           # 最多显示几行

export PATH=/opt/homebrew/bin:/usr/bin:/bin
AERO="$HOME/Documents/fantastic-i3/macos/yabai/aero"
STATE="/tmp/yabai-aero-$USER"
mkdir -p "$STATE"

# 列表开着时再按 ⌘⇥ 不重复打开
lock="$STATE/switcher.lock"
if ! mkdir "$lock" 2>/dev/null; then
    kill -0 "$(cat "$lock/pid" 2>/dev/null)" 2>/dev/null && exit 0
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || exit 0
fi
echo $$ >"$lock/pid"
trap "rm -rf '$lock'" EXIT

mode=${1:---auto}
case $mode in
    --auto)
        # 等 ⌘ 松开，最多 HOLD_SECONDS 秒：松开了就是"快速按一下"
        if "$AERO" helper wait-release command "$HOLD_SECONDS"; then mode=--back; else mode=--list; fi ;;
    --list | --back) ;;
    *) echo "用法：window_switcher [--auto | --list | --back]" >&2; exit 2 ;;
esac

mru=$(jq -R -s 'split("\n") | map(select(length > 0) | tonumber)' "$STATE/mru" 2>/dev/null || echo '[]')
windows=$(yabai -m query --windows)

# 当前窗口。焦点在面板、对话框这类不在列表里的窗口上时（比如 Gemini 激活时焦点会落到一个小窗口上），
# 把同一应用最近用过的普通窗口当作当前窗口；否则快速按 ⌘⇥ 只会切到这个应用自己的主窗口，看起来像没反应
focused=$(yabai -m query --windows --window 2>/dev/null)
cur=$(jq -r --argjson w "$windows" --argjson mru "$mru" '
    . as $f
    | if .role == "AXWindow" and .subrole == "AXStandardWindow" then .id
      else [$w[] | select(.pid == $f.pid and .role == "AXWindow" and .subrole == "AXStandardWindow")]
           | min_by(.id as $i | $mru | index($i) // 1e6) | .id end
    | values' <<<"$focused" 2>/dev/null)
recent=$(yabai -m query --windows --window recent 2>/dev/null | jq -r '.id // empty')

# 窗口按最近使用排序：上一个用过的在最前，当前窗口在最后
rows=$(jq -r <<<"$windows" \
    --argjson sp "$(yabai -m query --spaces)" --argjson mru "$mru" \
    --arg cur "$cur" --arg recent "$recent" '
    ($sp | map({key: (.index | tostring), value: (if .label != "" then .label else (.index | tostring) end)}) | from_entries) as $lab
    | map(select(.role == "AXWindow" and .subrole == "AXStandardWindow" and .app != "choose" and .app != "aero-helper"))
    | to_entries
    | map(.key as $k | .value | (.id | tostring) as $id | . + {rank: (
        if $id == $cur then 1e9
        elif $id == $recent then -1
        else ((.id as $i | $mru | index($i)) // (1e6 + $k)) end)})
    | sort_by(.rank)
    | .[]
    | [(.id | tostring), ($lab[.space | tostring] // "?"), .app, .title,
       (if (.id | tostring) == $cur then "当前" elif ."is-minimized" then "最小化" elif ."is-hidden" then "已隐藏" else "" end),
       (.pid | tostring)]
    | @tsv')
prev=$(head -n1 <<<"$rows" | cut -f1)

if [ "$mode" = --back ]; then
    "$AERO" log "⌘⇥ 快按：焦点 $(jq -r '"\(.id) \(.app) \(.subrole)"' <<<"$focused" 2>/dev/null)，当前 ${cur:-?}，切到 ${prev:-无} $(head -n1 <<<"$rows" | cut -f3)"
    [ -n "$prev" ] && [ "$prev" != "$cur" ] && "$AERO" focus-window "$prev"
    exit 0
fi

# 列表按桌面编号排序；同一桌面内保持最近使用的顺序（稳定排序）；默认选中上一个用过的窗口
id=$(sort -s -t $'\t' -k2,2n <<<"$rows" |
    "$AERO" helper switcher --apps --select "$prev" --font-size "$FONT_SIZE" --width "$WIDTH" --rows "$ROWS") || exit 0
case $id in
    app:*)
        # 没有窗口的应用（app:pid:bundle id）：像点 Dock 图标一样打开。新窗口可能被规则放到别的工作区，出现后跟过去
        pid=${id#app:}
        open -b "${pid#*:}"
        pid=${pid%%:*}
        for _ in $(seq 20); do
            win=$(yabai -m query --windows | jq -r --argjson pid "$pid" \
                'map(select(.pid == $pid and .subrole == "AXStandardWindow"))[0].id // empty')
            if [ -n "$win" ]; then "$AERO" focus-window "$win"; break; fi
            sleep 0.1
        done ;;
    ?*) "$AERO" focus-window "$id" ;;
esac
