#!/usr/bin/env sh
# yabai 配置 —— 从 AeroSpace 迁移（../aerospace/aerospace.toml），行为与原配置保持一致。
# 链接到 ~/.config/yabai/yabairc。快捷键在 ../skhd/skhdrc，AeroSpace 命令的模拟在 ./aero。
#
# 工作区 = macOS 桌面，编号 1-10（⌥1 … ⌥9 ⌥0 切换，⌥⇧+数字 把窗口移过去）。
# aerospace.toml 里的字母工作区已改成数字，规则按原来所在的桌面位置换算，个别应用另有指定：
#   B → 6（影音 / 网盘 / Outlook）  C → 7（AI）  N → 8（笔记）  X → 10（系统设置）
#   终端（iTerm2 / kitty / Terminal）→ 5    腾讯会议 → 9    微信 → 10（主窗口平铺）
#   Z 里的其他应用（浏览器、Chrome、知乎）→ 不自动分配，在哪个工作区打开就留在哪里
#
# 需要 yabai 脚本扩展（SA）的功能：瞬间切换工作区（无动画）、自动创建 10 个桌面、把工作区移到其他显示器。
# 没有 SA 时切换工作区改用 macOS 自带的桌面快捷键（有动画），桌面要自己在调度中心里加够 10 个；
# 移动窗口到其他工作区（⌥⇧+数字、下面规则里的工作区分配）不需要 SA。
# 开启 SA：运行 ./setup-sa（只需一次；yabai 升级后再运行一次）。

AERO="$HOME/Documents/fantastic-i3/macos/yabai/aero"

# aero reload 会重新执行本文件：先清掉旧的规则和信号
while yabai -m rule --remove 0 2>/dev/null; do :; done
while yabai -m signal --remove 0 2>/dev/null; do :; done

# ---- 脚本扩展 + 桌面快捷键模式（Dock 重启后 SA 会掉，需要重新加载）----
yabai -m signal --add event=dock_did_restart action="$AERO keys auto"
"$AERO" keys auto

# 开机登录时 yabai 和"重新打开窗口"恢复的应用一起启动，那些窗口 yabai 常常拿不到（没有 AX 引用）：
# 规则不生效（全挤在桌面 1），⌥⇧N、⌥⇥、换位置都找不到它们。重启一次 yabai 就好。
# 所以开机后第一次启动时，等 20 秒，还有拿不到的窗口就重启一次（标记在 /tmp，开机会清空，所以每次开机最多一次；
# 关了窗口但还在后台的应用——如微信——也会让它重启这一次，无害）。
if [ -z "$AERO_RELOAD" ] && mkdir "/tmp/yabai-aero-$USER/login-rescan" 2>/dev/null; then
    (sleep 20
     yabai -m query --windows | jq -e 'any(.[]; ."has-ax-reference" | not)' >/dev/null &&
         "$AERO" log "开机后有 yabai 拿不到的窗口，重启 yabai" && yabai --restart-service) >/dev/null 2>&1 &
fi

# ⌥ + Caps Lock = 工作区 10：skhd 绑不了 Caps Lock（外接键盘上改成了 🌐/fn），由 aero-helper 监听。
# yabai 重启时连同它一起被结束，这里再启动；aero reload 时它还在就不动。
HELPER="$HOME/.cache/fantastic-i3/aero-helper"
if [ -z "$AERO_RELOAD" ] || ! pgrep -qf "^$HELPER option-fn"; then
    pkill -f "^$HELPER option-fn" 2>/dev/null
    "$AERO" helper >/dev/null 2>&1   # 需要时编译
    "$HELPER" option-fn "$AERO workspace 10" >/dev/null 2>&1 &
fi

# ⌘⇥ 和 ⌘Space 交给 skhd（按应用切换，见 window_switcher --apps）：关掉 macOS 自带的应用切换器和 Spotlight 的快捷键。
# 重新登录后会恢复，所以每次都关
"$AERO" helper native-hotkeys off

# 切桌面后 macOS 有时把焦点给 Finder（桌面本身）而不是这个桌面上的窗口：补一下（见 aero ensure-focus）
yabai -m signal --add event=space_changed action="$AERO ensure-focus"

# 记录窗口的使用顺序，⌥⇥ 窗口切换器按它排序（上一个用过的窗口排第一）
yabai -m signal --add event=window_focused action="$AERO mru-push \$YABAI_WINDOW_ID"

# SketchyBar 顶栏（../sketchybar）：顶上给它留出 24 的高度（和系统菜单栏一样高，菜单栏已设为自动隐藏），焦点窗口 / 标题变了通知它
if command -v sketchybar >/dev/null 2>&1; then
    yabai -m config external_bar all:24:0
    yabai -m signal --add event=window_focused action="sketchybar --trigger window_focus"
    yabai -m signal --add event=window_title_changed action="sketchybar --trigger title_change"
fi

# 在调度中心里添加 / 删除桌面后，重新登记规则（规则里的工作区在登记时才确定）。
# 进出原生全屏也会新建 / 删掉一个桌面，那种不 reload（见 aero spaces-changed）
yabai -m signal --add event=space_created action="$AERO spaces-changed"
yabai -m signal --add event=space_destroyed action="$AERO spaces-changed"

# ---- 布局：tiles，横向根容器，间距 2 ----
yabai -m config layout                bsp
yabai -m config split_type            vertical      # 新窗口都并排成列（AeroSpace 宽屏的 horizontal 容器）
yabai -m config window_placement      second_child  # 新窗口放在当前窗口右边
yabai -m config auto_balance          y-axis        # 各列等宽（AeroSpace 新窗口平分宽度；y-axis = 平衡竖直分隔线）
yabai -m config split_ratio           0.50
yabai -m config top_padding           2
yabai -m config bottom_padding        2
yabai -m config left_padding          2
yabai -m config right_padding         2
yabai -m config window_gap            2
yabai -m config mouse_follows_focus   off           # on-focused-monitor-changed = []
yabai -m config focus_follows_mouse   off
yabai -m config window_origin_display focused       # 新窗口出现在当前显示器
# AeroSpace 没有的小功能：按住 fn 左键拖动 = 移动窗口，右键拖动 = 调整大小（fn 不与任何软件冲突）
yabai -m config mouse_modifier        fn
yabai -m config mouse_action1         move
yabai -m config mouse_action2         resize
yabai -m config mouse_drop_action     swap

# ---- 工作区（10 个桌面始终存在）----
# 开机登录时 yabai 刚启动的几秒里查询会返回残缺的 JSON：先等它能正常回答（最多 5 秒）再补齐桌面。
for _ in $(seq 50); do
    yabai -m query --spaces 2>/dev/null | jq -e 'length > 0' >/dev/null 2>&1 && break
    sleep 0.1
done
"$AERO" spaces

# ---- [[on-window-detected]] ----
# rule <工作区|-> <条件 与 属性…>
#   layout floating → manage=off    layout tiling → manage=on    move-node-to-workspace X → 第一个参数 X
#   大多是 -：程序启动后留在当前工作区。有固定工作区的：Edge → 1，iTerm2 / kitty / 终端 → 5，微信 → 10。
#   规则只挪不跟（--apply 时会到处跳）；跟过去交给 follow
# center <条件…>
#   exec-and-forget center-window → 浮动窗口出现时居中
#
# 与 AeroSpace 的差别及处理：
#   · AeroSpace 用 bundle id 匹配，yabai 只能用应用名：下面写的是本机（繁体中文系统）显示的名字，
#     系统应用同时写了英文 / 繁体 / 简体名。
#   · AeroSpace 只执行第一条匹配的规则；yabai 会执行所有匹配的规则。按应用名的规则互不重叠，
#     按标题的规则（Figure / python / Hugging Face）会自动排除前面已经有规则的应用（$TAKEN），
#     结果与 AeroSpace 相同。
#   · 原来按标题匹配 Cursor / Code / Trae 的三条规则改成按应用名匹配，避免误伤标题里带这些词的其他窗口。
#   · 目标桌面不存在时（没有 SA 且桌面不够），规则仍然生效，只是不移动窗口。
TAKEN=''
rule() {
    space=$1
    shift
    case " $* " in
        *" title="*) ;;
        *) for arg in "$@"; do
               case $arg in app=*) TAKEN="${TAKEN:+$TAKEN|}${arg#app=}" ;; esac
           done ;;
    esac
    if [ "$space" != - ] && yabai -m query --spaces --space "$space" >/dev/null 2>&1; then
        yabai -m rule --add "$@" space="$space"
    else
        yabai -m rule --add "$@"
    fi
}
center() {
    yabai -m signal --add event=window_created action="$AERO center \$YABAI_WINDOW_ID" "$@"
}
TILE='subrole=^AXStandardWindow$'   # 强制平铺只针对普通窗口，对话框 / 弹窗照常浮动
# follow <工作区> <应用名正则> [--on-activate]：有固定工作区的应用，新开的窗口被挪过去时人跟过去；
# 带 --on-activate 的，从程序坞等激活它（当前桌面上没有它的窗口）时也跟过去（见 aero follow）
follow() {
    yabai -m signal --add event=window_created app="$2" action="$AERO follow window \$YABAI_WINDOW_ID $1"
    [ "${3:-}" = --on-activate ] &&
        yabai -m signal --add event=application_activated app="$2" action="$AERO follow app \$YABAI_PROCESS_ID"
    return 0
}

# 菜单栏小工具、系统小窗口（AeroSpace 会自动浮动它们）；aero-helper 是 ⌥⇥ / ⌘⇥ 切换列表
rule - app='^(Calculator|計算機|计算器|Archive Utility|封存工具程式|归档实用工具)$' manage=off
rule - app='^(Stats|BetterDisplay|Mos|Raycast|Dropover|Snipaste|iShot|iBar|AltTab|Wins|choose|aero-helper)$' manage=off
rule - app='^(超級右鍵|超级右键|iRightMouse)' manage=off

# 以下顺序与 aerospace.toml 相同
rule - app='^(Microsoft Outlook|Outlook)$' manage=off
center app='^(Microsoft Outlook|Outlook)$'
rule - app='^(百度网盘|百度網盤|BaiduNetdisk.*)$' manage=off                 # com.baidu.netdisk / BaiduNetdisk-mac
rule - app='^([Hh]armony[Oo][Ss]|鸿蒙|鴻蒙)' manage=off                      # com.HarmonyOSInterconnection.app
rule - app='^Google Chrome$' manage=off
rule - app='^(Cherry Studio|CherryStudio)$' manage=off
center app='^(Cherry Studio|CherryStudio)$'
# 微信：所有窗口都去工作区 10，主窗口平铺，其他窗口（聊天小窗、图片、朋友圈…）浮动。
# 按应用名分配工作区，不按标题：主窗口刚出现时标题可能还是空的，规则只在窗口出现的那一刻匹配一次。
rule 10 app='^(WeChat|微信)$' "$TILE"                                        # 只挪普通窗口：截图时的全屏遮罩之类别动
follow 10 '^(WeChat|微信)$'
rule - app='^(WeChat|微信)$' title!='^(微信|WeChat)?$' manage=off
yabai -m signal --add event=window_created app='^(WeChat|微信)$' action="$AERO float-fixed \$YABAI_WINDOW_ID"  # 扫码登录窗口也叫"微信"，但不能调整大小
rule - app='^Microsoft PowerPoint$' manage=off
rule - app='^Microsoft Word$' manage=off
rule - app='^Microsoft Excel$'                                               # 平铺（以前是浮动）
rule - app='^(TencentMeeting|腾讯会议|騰訊會議)$' manage=off
rule - app='^QQ$' manage=off
rule - app='^Finder$' manage=off
rule - app='^(闪电说|閃電說)' manage=off                                    # cn.shandianshuo.desktop
rule - app='^Clash Verge' manage=off
rule 5 app='^kitty$' manage=off
center app='^kitty$'
rule 5 app='^iTerm2$' "$TILE" manage=on
follow 5 '^(iTerm2|kitty|Terminal|終端機|终端)$'
rule - app='^(哔哩哔哩|嗶哩嗶哩|bilibili)$' manage=off
rule - app='^(QQMusic|QQ音乐|QQ音樂)$' manage=off
rule - app='^Claude$' "$TILE" manage=on
rule - app='^Google Gemini' manage=off
rule - app='^ChatGPT$' "$TILE" manage=on
rule - app='^Cursor$' "$TILE" manage=on
rule - app='^(Code|Visual Studio Code)$' "$TILE" manage=on
rule - app='^(TRAE|Trae|Trae CN)$' "$TILE" manage=on
rule - app='^(小红书|X)$' "$TILE" manage=on
rule - app='^知乎$' "$TILE" manage=on
rule - app='^(Calendar|行事曆|日历)$' manage=off
rule - app='^(Activity Monitor|活動監視器|活动监视器)$' manage=off
center app='^(Activity Monitor|活動監視器|活动监视器)$'
rule - app='^(Preview|預覽程式|预览)$' manage=off
rule - app='^Photo Booth$' manage=off
rule - app='^App Store$' manage=off
rule - title='^(Figure*)' app!="$TAKEN" manage=off
rule - title='^(python*)' app!="$TAKEN" manage=off
rule 5 app='^(Terminal|終端機|终端)$' manage=off
rule - app='^(Notes|備忘錄|备忘录)$' manage=off
rule - app='^Typora$' manage=off
rule - app='^Obsidian$' manage=off
rule - app='^Notion$' manage=off
rule - app='^Zotero$' manage=off   # aerospace.toml 里 Zotero 主窗口平铺的那条排在这条后面，从未生效，这里保持一致
rule - app='^(Douyin|抖音)$' manage=off
rule - app='^Spotify$' manage=off
rule - app='^(Music|音樂|音乐)$' manage=off
rule - app='^(Safari|Safari浏览器)$' manage=off
rule 1 app='^Microsoft Edge$' "$TILE" manage=on                                # 画中画、弹窗不是普通窗口：照常浮动、留在原地
follow 1 '^Microsoft Edge$' --on-activate
rule - app='^Arc$' manage=off
rule - app='^Brave Browser$' manage=off
rule - app='^Firefox$' manage=off
rule - title='(Hugging Face|ModelScope|魔搭)' app!="$TAKEN" manage=off
rule - app='^(System Settings|系統設定|系统设置)$' manage=off

# 开机后 5 分钟内启动时，对已经打开的窗口也执行一遍规则：登录时恢复的窗口常常全挤在一个桌面上。
# 其他时候（手动重启 yabai、aero reload）不执行，不把你手动挪过的窗口拉回规则指定的工作区
boot=$(sysctl -n kern.boottime | sed 's/^{ sec = \([0-9]*\).*/\1/')
if [ -z "${AERO_RELOAD:-}" ] && [ $(($(date +%s) - boot)) -lt 300 ]; then
    yabai -m rule --apply
fi

echo "yabai configuration loaded"
