#!/bin/bash
# ⌥G：跳到 Safari —— 优先当前工作区上的 Safari 窗口，其次任意工作区上的（会切过去）；
# 一个 Safari 窗口都没有就在当前工作区新开一个。
# （aerospace.toml 的 alt-g 是"去工作区 Z 找 Safari"，字母工作区取消后改成这样。）
export PATH=/opt/homebrew/bin:/usr/bin:/bin

cur=$(yabai -m query --spaces --space | jq -r .index)
id=$(yabai -m query --windows | jq -r --argjson cur "$cur" '
    [.[] | select(.app == "Safari" and .subrole == "AXStandardWindow" and (."is-minimized" | not))]
    | (map(select(.space == $cur)) + .)[0].id // empty')
if [ -n "$id" ]; then
    yabai -m window --focus "$id"
else
    osascript -e 'tell application "Safari" to make new document' \
              -e 'tell application "Safari" to activate'
fi
