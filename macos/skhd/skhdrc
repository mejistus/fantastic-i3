# skhd 快捷键 —— 与 aerospace.toml 的 [mode.*.binding] 一一对应（yabai 版）
# 链接到 ~/.config/skhd/skhdrc；aero 是 ../yabai/aero，用来模拟 AeroSpace 的命令。
#
# 切换工作区（⌥1 … ⌥9 ⌥0 = 工作区 1 … 10）和 ⌃H/⌃L 在文件末尾 .load 的 workspaces.skhdrc 里：
# 它由 aero keys 按 SA 是否可用，链接到 workspaces-sa.skhdrc 或 workspaces-native.skhdrc。

# 进入每个模式时通知 SketchyBar 顶栏显示 / 隐藏 RESIZE、SERVICE（没装 SketchyBar 也不影响）
:: default : sketchybar --trigger skhd_mode MODE=default 2>/dev/null
:: resize  : sketchybar --trigger skhd_mode MODE=resize 2>/dev/null
:: service : sketchybar --trigger skhd_mode MODE=service 2>/dev/null

# ================================================================ mode.main

# focus left/down/up/right
alt - h     : yabai -m window --focus west
alt - j     : yabai -m window --focus south
alt - k     : yabai -m window --focus north
alt - l     : yabai -m window --focus east
alt - left  : yabai -m window --focus west
alt - down  : yabai -m window --focus south
alt - up    : yabai -m window --focus north
alt - right : yabai -m window --focus east

# move left/down/up/right
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east
# 方向键版（代价：所有应用里按词选择 ⌥⇧←→、按段选择 ⌥⇧↑↓ 都被占掉）
alt + shift - left  : yabai -m window --swap west
alt + shift - down  : yabai -m window --swap south
alt + shift - up    : yabai -m window --swap north
alt + shift - right : yabai -m window --swap east

# fullscreen / layout floating tiling
alt - f         : $HOME/Documents/fantastic-i3/macos/yabai/aero fullscreen
alt + shift - f : $HOME/Documents/fantastic-i3/macos/yabai/aero toggle-float

# resize smart -50 / +50（⌥- ⌥=）
alt - 0x1B : $HOME/Documents/fantastic-i3/macos/yabai/aero resize smart -50
alt - 0x18 : $HOME/Documents/fantastic-i3/macos/yabai/aero resize smart +50

# ⌥⇧1 … ⌥⇧9 ⌥⇧0：把当前窗口移到工作区 1 … 10，并跟过去
alt + shift - 1 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 1 --focus-follows-window
alt + shift - 2 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 2 --focus-follows-window
alt + shift - 3 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 3 --focus-follows-window
alt + shift - 4 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 4 --focus-follows-window
alt + shift - 5 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 5 --focus-follows-window
alt + shift - 6 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 6 --focus-follows-window
alt + shift - 7 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 7 --focus-follows-window
alt + shift - 8 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 8 --focus-follows-window
alt + shift - 9 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 9 --focus-follows-window
alt + shift - 0 : $HOME/Documents/fantastic-i3/macos/yabai/aero move-node-to-workspace 10 --focus-follows-window

# move-workspace-to-monitor --wrap-around next
alt + shift - tab : $HOME/Documents/fantastic-i3/macos/yabai/aero move-workspace-to-monitor --wrap-around next

# 窗口切换器（⌥⇥）和应用切换器（⌘⇥，macOS 自带的由 yabairc 关掉；⌘Space 直接弹出它的列表，Spotlight 的快捷键同样关掉）
#   快速按一下 = 回到上一个用过的窗口 / 应用；按住 ⌥ / ⌘ = 弹出列表（同时切到英文输入法，打字直接搜索）
#   ⌘⇥ 列的是启动台里的所有应用：有窗口的在最上面，然后是开着但没窗口的，最后是没开的
# 列表开着时 skhd 不拦截任何键（见下面的 .blacklist）：⌥⇥ / ⌥⇧⇥（⌘⇥ / ⌘⇧⇥）在列表里往下 / 往上选，Esc 关闭
alt - tab : $HOME/Documents/fantastic-i3/macos/window_switcher --auto
cmd - tab : $HOME/Documents/fantastic-i3/macos/window_switcher --apps --auto
cmd - space : $HOME/Documents/fantastic-i3/macos/window_switcher --apps --list
.blacklist [
    "aero-helper"
]

# 当前工作区开 Finder
alt - d   : $HOME/Documents/fantastic-i3/macos/new_window_here

# 工作区别名（用 aero workspace，有没有 SA 都能用）：⌥B = ⌥4，⌥T = ⌥5，⌥Z = ⌥8，⌥C = ⌥9
alt - b : $HOME/Documents/fantastic-i3/macos/yabai/aero workspace 4
alt - t : $HOME/Documents/fantastic-i3/macos/yabai/aero workspace 5
alt - z : $HOME/Documents/fantastic-i3/macos/yabai/aero workspace 8
alt - c : $HOME/Documents/fantastic-i3/macos/yabai/aero workspace 9
# ⌥G = 工作区 1 的默认浏览器：那里有它的窗口就切过去，没有就切到工作区 1 新开一个
alt - g : $HOME/Documents/fantastic-i3/macos/yabai/focus_browser
# ⌥ + Caps Lock = ⌥0（工作区 10）：skhd 绑不了 Caps Lock（外接键盘上改成了 🌐/fn），
# 由 yabairc 启动的 aero-helper option-fn 监听

# mode resize / mode service
alt - r  ; resize
ctrl - s ; service

# ================================================================ mode.service
# skhd 的一个按键不能同时"执行命令 + 切换模式"：命令最后用 skhd -k "f20" 回到 default

service < escape : skhd -k "f20"; $HOME/Documents/fantastic-i3/macos/yabai/aero reload
service < r      ; resize
service < f      : skhd -k "f20"; $HOME/Documents/fantastic-i3/macos/yabai/aero toggle-space-float
service < space  ; default
service < j      : yabai -m window --toggle split; skhd -k "f20"
service < h      : yabai -m window --insert east; skhd -k "f20"
service < v      : yabai -m window --insert south; skhd -k "f20"
service < f20    ; default

# ================================================================ mode.resize

resize < 0x1B  : $HOME/Documents/fantastic-i3/macos/yabai/aero resize smart -50
resize < 0x18  : $HOME/Documents/fantastic-i3/macos/yabai/aero resize smart +50
resize < h     : $HOME/Documents/fantastic-i3/macos/yabai/aero resize width -50
resize < j     : $HOME/Documents/fantastic-i3/macos/yabai/aero resize height +50
resize < k     : $HOME/Documents/fantastic-i3/macos/yabai/aero resize height -50
resize < l     : $HOME/Documents/fantastic-i3/macos/yabai/aero resize width +50
resize < left  : $HOME/Documents/fantastic-i3/macos/yabai/aero resize width -50
resize < up    : $HOME/Documents/fantastic-i3/macos/yabai/aero resize height +50
resize < down  : $HOME/Documents/fantastic-i3/macos/yabai/aero resize height -50
resize < right : $HOME/Documents/fantastic-i3/macos/yabai/aero resize width +50
resize < return ; default
resize < escape ; default
resize < space  ; default

# ================================================================ 工作区切换

.load "workspaces.skhdrc"
