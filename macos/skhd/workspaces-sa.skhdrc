# 工作区切换 —— SA 模式（yabai 脚本扩展已加载）
# 由 yabai 瞬间切换，没有动画；macOS 自带的"切换到桌面 N"快捷键已被 aero keys sa 关闭。

# ⌥1 … ⌥9 ⌥0 = 工作区 1 … 10
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10

# workspace next / prev（⌃H ⌃L，或 ⌃⌥← ⌃⌥→）
ctrl - l           : $HOME/Documents/fantastic-i3/macos/yabai/aero workspace next
ctrl - h           : $HOME/Documents/fantastic-i3/macos/yabai/aero workspace prev
ctrl + alt - right : $HOME/Documents/fantastic-i3/macos/yabai/aero workspace next
ctrl + alt - left  : $HOME/Documents/fantastic-i3/macos/yabai/aero workspace prev
