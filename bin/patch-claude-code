# --------------------------------------------------------------------------- io
def die(msg: str, code: int = 1) -> "None":
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def load_json(path: Path, default=None):
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        die(f"{path} 不是合法 JSON: {exc}")


def save_json(path: Path, obj) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.replace(path)


def mask(secret: str) -> str:
    if not secret:
        return ""
    return secret[:7] + "…" + secret[-4:] if len(secret) > 14 else secret[:3] + "…"


def zshrc_var(name: str):
    """读 ~/.zshrc 里 `export NAME=...` 的值（含引号/无引号两种写法）。"""
    rc = Path.home() / ".zshrc"
    if not name or not rc.exists():
        return None
    text = rc.read_text(encoding="utf-8", errors="replace")
    m = re.search(
        r"^[ \t]*(?:export[ \t]+)?" + re.escape(name) + r"[ \t]*=[ \t]*(['\"]?)([^'\"\n#]+)\1",
        text,
        re.M,
    )
    return m.group(2).strip() if m else None


# ------------------------------------------------------------------- profiles
def profile_path(name: str) -> Path:
    if not NAME_RE.match(name):
        die(f"档案名只允许字母数字 . _ -（收到 {name!r}）")
    return PROFILE_DIR / f"{name}.json"


def profiles() -> "dict[str, Path]":
    if not PROFILE_DIR.is_dir():
        return {}
    return {p.stem: p for p in sorted(PROFILE_DIR.glob("*.json"))}


def load_profile(name: str) -> dict:
    path = profiles().get(name)
    if path is None:
        available = ", ".join(profiles()) or "(空)"
        die(f"没有档案 {name!r}；可用: {available}")
    prof = load_json(path, {})
    prof.setdefault("env", {})
    return prof


def save_profile(name: str, prof: dict) -> Path:
    path = profile_path(name)
    save_json(path, prof)
    return path


def resolve_auth(prof: dict, strict: bool = True):
    """返回 (token, 来源说明)。"""
    name = prof.get("auth_var")
    if name:
        token = zshrc_var(name)
        if token:
            return token, f"~/.zshrc 的 ${name}"
        if strict:
            die(f"档案引用的 shell 变量 ${name} 在 ~/.zshrc 里找不到")
        return None, f"${name}(缺失)"
    if prof.get("auth_env"):
        name = prof["auth_env"]
        token = os.environ.get(name)
        if token:
            return token, f"环境变量 ${name}"
        if strict:
            die(f"环境变量 ${name} 为空")
        return None, f"${name}(缺失)"
    if prof.get("auth_token"):
        return prof["auth_token"], "档案内明文"
    if strict:
        die("档案里没有 auth_var / auth_env / auth_token")
    return None, "(无)"


def alias_target(prof: dict, model: str):
    """`sonnet` → 档案里 ANTHROPIC_DEFAULT_SONNET_MODEL 的值；不是别名就返回 None。"""
    key = {
        "sonnet": "ANTHROPIC_DEFAULT_SONNET_MODEL",
        "opus": "ANTHROPIC_DEFAULT_OPUS_MODEL",
        "haiku": "ANTHROPIC_DEFAULT_HAIKU_MODEL",
    }.get(model)
    return (prof.get("env") or {}).get(key) if key else None


def _effective_base(prof: dict) -> "str | None":
    proxy = prof.get("proxy") or {}
    if proxy.get("port"):
        return f"http://127.0.0.1:{proxy['port']}"
    return (prof.get("env") or {}).get("ANTHROPIC_BASE_URL")


def active_profile():
    try:
        settings = load_json(SETTINGS, {}) or {}
    except SystemExit:
        return None
    base = (settings.get("env") or {}).get("ANTHROPIC_BASE_URL")
    if not base:
        return None
    # 多个档案可能共用同一个 base_url（例如同一网关的旧/新档案），
    # 不能只按 URL 认：按 model / 三个默认模型 / picker / fallback 打分，取最像的。
    s_env = settings.get("env") or {}
    s_model = settings.get("model")
    s_picker = (settings.get("modelPicker") or {}).get("options")
    best = None
    for name, path in profiles().items():
        prof = load_json(path, {}) or {}
        p_env = prof.get("env") or {}
        if _effective_base(prof) != base:
            continue
        score = 0
        if prof.get("model") == s_model:
            score += 4
        elif alias_target(prof, prof.get("model")) == s_model:
            score += 2
        for key in (
            "ANTHROPIC_DEFAULT_OPUS_MODEL",
            "ANTHROPIC_DEFAULT_SONNET_MODEL",
            "ANTHROPIC_DEFAULT_HAIKU_MODEL",
            "CLAUDE_CODE_MAX_CONTEXT_TOKENS",
        ):
            if (p_env.get(key) or None) == (s_env.get(key) or None):
                score += 1
        if (prof.get("modelPicker") or {}).get("options") == s_picker:
            score += 1
        if (prof.get("fallbackModel") or []) == (settings.get("fallbackModel") or []):
            score += 1
        if best is None or score > best[0]:
            best = (score, name)
    return best[1] if best else None


# ----------------------------------------------------------------- settings
def backup_settings() -> "Path | None":
    if not SETTINGS.exists():
        return None
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    dest = BACKUP_DIR / f"settings.json.{stamp}"
    shutil.copy2(SETTINGS, dest)
    return dest


def build_settings(prof: dict, current: dict) -> dict:
    """把档案合进现有 settings（保留 hooks/statusLine/plugins 等非托管键）。"""
    settings = json.loads(json.dumps(current))  # deep copy
    env = {k: v for k, v in (settings.get("env") or {}).items() if k not in MANAGED_ENV}
    env.update({k: str(v) for k, v in (prof.get("env") or {}).items()})
    proxy = prof.get("proxy") or {}
    if proxy.get("port"):
        env["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{proxy['port']}"
    token, _ = resolve_auth(prof)
    env["ANTHROPIC_AUTH_TOKEN"] = token
    settings["env"] = dict(sorted(env.items()))
    settings["model"] = prof.get("model", settings.get("model", "sonnet"))
    if prof.get("modelPicker"):
        settings["modelPicker"] = prof["modelPicker"]
    else:
        settings.pop("modelPicker", None)
    fallback = prof.get("fallbackModel") or []
    if fallback:
        settings["fallbackModel"] = fallback
    else:
        settings.pop("fallbackModel", None)
    return settings


def apply_profile(name: str, dry_run: bool = False, quiet: bool = False) -> dict:
    prof = load_profile(name)
    current = load_json(SETTINGS, {}) or {}
    settings = build_settings(prof, current)
    resolved = {
        "profile": name,
        "label": prof.get("label", ""),
        "base_url": settings["env"].get("ANTHROPIC_BASE_URL"),
        "upstream": _upstream_of(prof),
        "proxy": (prof.get("proxy") or {}).get("port"),
        "default_model": settings.get("model"),
        "opus": settings["env"].get("ANTHROPIC_DEFAULT_OPUS_MODEL"),
        "sonnet": settings["env"].get("ANTHROPIC_DEFAULT_SONNET_MODEL"),
        "haiku": settings["env"].get("ANTHROPIC_DEFAULT_HAIKU_MODEL"),
        "max_context": settings["env"].get("CLAUDE_CODE_MAX_CONTEXT_TOKENS"),
        "picker_rows": len((settings.get("modelPicker") or {}).get("options") or []),
        "replace_builtin": (settings.get("modelPicker") or {}).get("replaceBuiltInOptions"),
        "fallback": settings.get("fallbackModel") or [],
    }
    if dry_run:
        resolved["dry_run"] = True
        masked_env = dict(settings["env"])
        if masked_env.get("ANTHROPIC_AUTH_TOKEN"):
            masked_env["ANTHROPIC_AUTH_TOKEN"] = mask(masked_env["ANTHROPIC_AUTH_TOKEN"])
        resolved["settings_preview"] = {
            "env": masked_env,
            "model": settings.get("model"),
            "fallbackModel": settings.get("fallbackModel"),
            "modelPicker": settings.get("modelPicker"),
        }
        print_summary(resolved)
        print("\nsettings.json 预览 (未写入):")
        print(json.dumps(resolved["settings_preview"], indent=2, ensure_ascii=False)[:1200])
        return resolved
    backup = backup_settings()
    save_json(SETTINGS, settings)
    resolved["backup"] = str(backup) if backup else None
    if not quiet:
        print_summary(resolved)
    return resolved


def print_summary(r: dict) -> None:
    print(f"active profile    : {r['profile']}" + (f"  ({r['label']})" if r.get("label") else ""))
    print(f"ANTHROPIC_BASE_URL: {r['base_url']}")
    if r.get("proxy"):
        print(f"upstream          : {r.get('upstream')}  (via local proxy :{r['proxy']})")
    print(f"models            : model={r['default_model']}  opus={r['opus']}  sonnet={r['sonnet']}  haiku={r['haiku']}")
    print(f"fallback          : " + (", ".join(r.get("fallback") or []) or "—"))
    print(f"max context       : {r['max_context']}")
    print(f"picker rows       : {r['picker_rows']}" + ("  (replaceBuiltInOptions=true)" if r["replace_builtin"] else ""))
    if r.get("backup"):
        print(f"backup            : {r['backup']}")


# ------------------------------------------------------------------ discovery
def http_json(url: str, token: str = None, payload: dict = None, timeout: int = 30, session: str = None):
    headers = {"accept": "application/json", "user-agent": "patch-claude-code/1"}
    if token:
        headers["authorization"] = f"Bearer {token}"
    if session:
        headers["x-opencode-session"] = session
    data = None
    if payload is not None:
        headers["content-type"] = "application/json"
        headers["anthropic-version"] = "2023-06-01"
        data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if data else "GET")
    ctx = ssl.create_default_context()
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
            return resp.status, resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode("utf-8", "replace")
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return 0, f"connection failed: {exc}"


# ------------------------------------------------------------------- proxy
# OpenCode Go 偶尔把上游的 4xx 吞成 `400 {"model":"..."}`（正文缺失，见
# opencode#53243 / #54996）。这种 400 往往按请求/路由偶发，重试一次就好；
# `run` 会起一个只活到 Claude Code 退出的本地代理，并通过 --settings 把
# ANTHROPIC_BASE_URL 临时指过来，不改 settings.json，也不需要常驻服务。
PROXY_RETRY_STATUS = {408, 425, 429, 500, 502, 503, 504, 529}


def _opaque_model_error(status: int, body: bytes) -> bool:
    if status != 400:
        return False
    text = body.decode("utf-8", "replace").strip()
    if not text:
        return True
    try:
        doc = json.loads(text)
    except json.JSONDecodeError:
        return False
    return isinstance(doc, dict) and set(doc.keys()) == {"model"}


def _proxy_log(line: str) -> None:
    try:
        PROXY_LOG.parent.mkdir(parents=True, exist_ok=True)
        if PROXY_LOG.exists() and PROXY_LOG.stat().st_size > 5_000_000:
            PROXY_LOG.replace(PROXY_LOG.with_suffix(".log.1"))
        with PROXY_LOG.open("a", encoding="utf-8") as fh:
            fh.write(time.strftime("%Y-%m-%d %H:%M:%S ") + line + "\n")
    except OSError:
        pass


def _fake_signature() -> str:
    return base64.b64encode(f"patch-claude-code:{uuid.uuid4().hex}".encode()).decode()


def _sign_message(doc: dict) -> bool:
    """给没有 signature 的 thinking 块补一个（非流式响应）。"""
    changed = False
    for block in doc.get("content") or []:
        if isinstance(block, dict) and block.get("type") == "thinking" and not block.get("signature"):
            block["signature"] = _fake_signature()
            changed = True
    return changed


def make_proxy_server(upstream: str, retries: int, port: int = 0):
    upstream = upstream.rstrip("/")

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *args):
            pass

        def _send(self, status, headers, body: bytes):
            self.send_response(status)
            for key in ("content-type", "request-id", "x-opencode-log-id", "retry-after"):
                if headers.get(key):
                    self.send_header(key, headers[key])
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def _chunk(self, data: bytes):
            self.wfile.write(f"{len(data):X}\r\n".encode() + data + b"\r\n")
            self.wfile.flush()

        def _sse(self, event, payload):
            line = f"event: {event}\ndata: {json.dumps(payload)}\n\n".encode()
            self._chunk(line)

        def _stream(self, resp):
            ctype = resp.headers.get("content-type", "application/octet-stream")
            if "text/event-stream" not in ctype:
                data = resp.read()
                if "json" in ctype:
                    try:
                        doc = json.loads(data)
                        if isinstance(doc, dict) and _sign_message(doc):
                            data = json.dumps(doc).encode()
                    except json.JSONDecodeError:
                        pass
                self.send_response(resp.status)
                for key in ("content-type", "request-id", "x-opencode-log-id"):
                    if resp.headers.get(key):
                        self.send_header(key, resp.headers[key])
                self.send_header("content-length", str(len(data)))
                self.end_headers()
                if self.command != "HEAD":
                    self.wfile.write(data)
                return
            self.send_response(resp.status)
            self.send_header("content-type", ctype)
            self.send_header("transfer-encoding", "chunked")
            self.end_headers()
            thinking = {}  # index -> 是否已经带 signature
            event = None
            data = None
            try:
                for raw in resp:
                    line = raw.rstrip(b"\r\n")
                    if not line:
                        if data is not None:
                            try:
                                payload = json.loads(data)
                            except json.JSONDecodeError:
                                self._chunk(f"event: {event or 'message'}\ndata: {data}\n\n".encode())
                                event, data = None, None
                                continue
                            kind = payload.get("type")
                            idx = payload.get("index")
                            if kind == "content_block_start":
                                block = payload.get("content_block") or {}
                                if block.get("type") == "thinking":
                                    thinking[idx] = bool(block.get("signature"))
                            elif kind == "content_block_delta":
                                if (payload.get("delta") or {}).get("type") == "signature_delta":
                                    thinking[idx] = True
                            elif kind == "content_block_stop" and idx in thinking and not thinking[idx]:
                                # Go 网关不给 thinking 签名；补一个，Claude Code 才会回传
                                self._sse("content_block_delta", {
                                    "type": "content_block_delta",
                                    "index": idx,
                                    "delta": {"type": "signature_delta", "signature": _fake_signature()},
                                })
                                thinking[idx] = True
                            self._sse(event or kind or "message", payload)
                        event, data = None, None
                        continue
                    if line.startswith(b"event:"):
                        event = line[6:].strip().decode()
                    elif line.startswith(b"data:"):
                        data = line[5:].strip().decode()
                self.wfile.write(b"0\r\n\r\n")
            except (BrokenPipeError, ConnectionResetError):
                pass

        def _forward(self):
            if self.path == "/__health":
                self._send(200, {"content-type": "application/json"}, b'{"ok":true}')
                return
            n = int(self.headers.get("content-length") or 0)
            body = self.rfile.read(n) if n else b""
            model = None
            think = signed = 0
            if body:
                try:
                    doc = json.loads(body)
                    model = doc.get("model")
                    for msg in doc.get("messages") or []:
                        for blk in msg.get("content") or []:
                            if isinstance(blk, dict) and blk.get("type") == "thinking":
                                think += 1
                                if blk.get("signature"):
                                    signed += 1
                except (json.JSONDecodeError, AttributeError):
                    pass
            headers0 = {
                k: v
                for k, v in self.headers.items()
                if k.lower() not in ("host", "content-length", "connection", "accept-encoding")
            }
            attempts = max(1, retries) if self.command == "POST" else 1
            url = upstream + self.path
            force_session = False
            for attempt in range(1, attempts + 1):
                headers = dict(headers0)
                if attempt > 2 or force_session:
                    # 前两次保持同一会话，尽量命中 prompt cache；
                    # 之后换 id，避免一直粘在坏后端上（会牺牲这一条的缓存）。
                    sid = f"patch-claude-code-retry-{uuid.uuid4().hex[:12]}"
                    headers["x-opencode-session"] = sid
                    headers["X-Claude-Code-Session-Id"] = sid
                req = urllib.request.Request(url, data=body or None, headers=headers, method=self.command)
                try:
                    with urllib.request.urlopen(req, timeout=900, context=ssl.create_default_context()) as resp:
                        _proxy_log(
                            f"{self.command} {self.path} model={model} think={think}/{signed} attempt={attempt} status={resp.status} "
                            f"log_id={resp.headers.get('x-opencode-log-id') or '-'}"
                        )
                        self._stream(resp)
                        return
                except urllib.error.HTTPError as exc:
                    err = exc.read()
                    missing_session = exc.code == 400 and b"MissingSessionID" in err[:600]
                    if missing_session:
                        force_session = True
                    retry = attempt < attempts and (
                        exc.code in PROXY_RETRY_STATUS
                        or _opaque_model_error(exc.code, err)
                        or missing_session
                    )
                    _proxy_log(
                        f"{self.command} {self.path} model={model} think={think}/{signed} attempt={attempt} status={exc.code} "
                        f"retry={'yes' if retry else 'no'} log_id={exc.headers.get('x-opencode-log-id') or '-'} "
                        f"body={err[:120].decode('utf-8', 'replace').replace(chr(10), ' ')}"
                    )
                    if retry:
                        time.sleep(min(2 ** (attempt - 1) * 0.5, 4.0))
                        continue
                    self._send(exc.code, exc.headers, err)
                    return
                except (urllib.error.URLError, TimeoutError, OSError) as exc:
                    retry = attempt < attempts
                    _proxy_log(
                        f"{self.command} {self.path} model={model} attempt={attempt} error={exc!r} "
                        f"retry={'yes' if retry else 'no'}"
                    )
                    if retry:
                        time.sleep(min(2 ** (attempt - 1) * 0.5, 4.0))
                        continue
                    msg = json.dumps({"type": "error", "error": {"type": "proxy_error", "message": str(exc)}}).encode()
                    self._send(502, {"content-type": "application/json"}, msg)
                    return

        do_POST = _forward
        do_GET = _forward

    class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
        daemon_threads = True
        allow_reuse_address = True

    return Server(("127.0.0.1", port), Handler)


def _upstream_of(prof: dict) -> str:
    proxy = prof.get("proxy") or {}
    env = prof.get("env") or {}
    upstream = proxy.get("upstream") or env.get("upstream_base_url") or env.get("ANTHROPIC_BASE_URL")
    if not upstream:
        die("档案里没有 ANTHROPIC_BASE_URL")
    if re.match(r"^http://(127\.0\.0\.1|localhost)(:\d+)?", upstream):
        die("档案的 base_url 已经指向本地代理；用 `proxy --upstream <真实地址>` 或先 proxy disable")
    return upstream


def cmd_proxy(args) -> int:
    if args.upstream:
        upstream = args.upstream
    else:
        name = args.profile or active_profile()
        if not name:
            die("没有生效档案；用 --profile 或 --upstream 指定")
        upstream = _upstream_of(load_profile(name))
    server = make_proxy_server(upstream, args.retries, args.port)
    print(f"proxy   : http://127.0.0.1:{server.server_address[1]} -> {upstream}", file=sys.stderr)
    print(f"retries : {args.retries}  log: {PROXY_LOG}", file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


# ------------------------------------------------------------ launchd daemon
def _launchctl(*args):
    try:
        return subprocess.run(["launchctl", *args], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        die(f"launchctl {' '.join(args)} 失败: {exc}")


def _proxy_health(port: int, timeout: float = 1.0) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/__health", timeout=timeout) as resp:
            return resp.status == 200
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


def _plist_path() -> Path:
    return LAUNCH_AGENT_DIR / f"{PROXY_LABEL}.plist"


def _daemon_install(name: str, port: int, retries: int) -> int:
    if sys.platform != "darwin":
        die("daemon 目前只支持 macOS launchd；其他系统用 `patch-claude-code proxy` 配合 systemd")
    prof = load_profile(name)
    upstream = _upstream_of(prof)
    if re.match(r"^http://(127\.0\.0\.1|localhost)(:\d+)?", upstream):
        die("档案的 base_url 已经指向本地地址，找不到真实上游")
    prof["proxy"] = {"port": port, "upstream": upstream}
    # 常驻代理会补 signature，所以这里重新打开 thinking
    prof["env"].pop("CLAUDE_CODE_DISABLE_THINKING", None)
    prof.pop("fallbackModel", None)
    save_profile(name, prof)

    args = [
        os.path.realpath(sys.executable),
        str(Path(__file__).resolve()),
        "proxy",
        "--profile", name,
        "--port", str(port),
        "--retries", str(retries),
    ]
    plist = {
        "Label": PROXY_LABEL,
        "ProgramArguments": args,
        "RunAtLoad": True,
        "KeepAlive": True,
        "ProcessType": "Background",
        "StandardOutPath": str(CLAUDE_DIR / "proxy-daemon.log"),
        "StandardErrorPath": str(CLAUDE_DIR / "proxy-daemon.err.log"),
    }
    LAUNCH_AGENT_DIR.mkdir(parents=True, exist_ok=True)
    path = _plist_path()
    with path.open("wb") as fh:
        plistlib.dump(plist, fh)
    path.chmod(0o644)

    uid = os.getuid()
    _launchctl("bootout", f"gui/{uid}", str(path))
    res = _launchctl("bootstrap", f"gui/{uid}", str(path))
    if res.returncode != 0:
        path.unlink(missing_ok=True)
        prof.pop("proxy", None)
        save_profile(name, prof)
        die(f"launchctl bootstrap 失败: {res.stderr.strip()[:300]}")
    _launchctl("kickstart", "-k", f"gui/{uid}/{PROXY_LABEL}")
    for _ in range(40):
        if _proxy_health(port):
            break
        time.sleep(0.25)
    else:
        _launchctl("bootout", f"gui/{uid}", str(path))
        path.unlink(missing_ok=True)
        prof.pop("proxy", None)
        save_profile(name, prof)
        die(f"代理没有起来；看 {CLAUDE_DIR / 'proxy-daemon.err.log'}")
    apply_profile(name)
    print(f"daemon  : {PROXY_LABEL}  :{port} -> {upstream}")
    print(f"plist   : {path}")
    print(f"log     : {PROXY_LOG}")
    print("下次直接运行 `claude` 即可：thinking 已开启，thinking 块会自动补 signature")
    return 0


def _daemon_uninstall(name: "str | None") -> int:
    if sys.platform != "darwin":
        die("daemon 目前只支持 macOS launchd")
    active = active_profile()
    path = _plist_path()
    if path.exists():
        _launchctl("bootout", f"gui/{os.getuid()}", str(path))
        path.unlink()
    removed = []
    for prof_name in ([name] if name else list(profiles())):
        prof = load_profile(prof_name)
        if not prof.get("proxy"):
            continue
        prof.pop("proxy", None)
        # 回到直连时重新关掉 thinking，否则又会撞上 thinking pass-back
        prof.setdefault("env", {})["CLAUDE_CODE_DISABLE_THINKING"] = "1"
        save_profile(prof_name, prof)
        removed.append(prof_name)
    if active and active in removed:
        apply_profile(active)
    print("已卸载 daemon；恢复直连: " + (", ".join(removed) or "(无)"))
    if active and active in removed:
        print("直接 `claude` 现在是无 thinking 的稳定模式；要 thinking 用 `patch-claude-code daemon install`")
    return 0


def _daemon_status() -> int:
    path = _plist_path()
    print(f"plist   : {path}  {'存在' if path.exists() else '不存在'}")
    if sys.platform == "darwin":
        res = _launchctl("print", f"gui/{os.getuid()}/{PROXY_LABEL}")
        print(f"launchd : {'running' if res.returncode == 0 else 'not loaded'}")
    name = active_profile()
    if not name:
        print("profile : 未托管")
        return 1
    prof = load_profile(name)
    proxy = prof.get("proxy") or {}
    if proxy:
        print(f"profile : {name}  :{proxy['port']} -> {proxy.get('upstream')}")
        print(f"health  : {'ok' if _proxy_health(proxy['port']) else 'down'}")
    else:
        print(f"profile : {name}  (direct)")
    return 0


def cmd_daemon(args) -> int:
    action = args.action
    if action == "status":
        return _daemon_status()
    name = args.profile or active_profile()
    if not name:
        die("没有生效档案；用 --profile 指定")
    if action == "install":
        return _daemon_install(name, args.port, args.retries)
    return _daemon_uninstall(args.profile)


def cmd_run(args) -> int:
    if getattr(args, "upstream", None):
        upstream = args.upstream
    else:
        name = args.profile or active_profile()
        if not name:
            die("没有生效档案；用 --profile <name> 或 --upstream <地址> 指定")
        upstream = _upstream_of(load_profile(name))
    server = make_proxy_server(upstream, args.retries, args.port or 0)
    port = server.server_address[1]
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    claude = shutil.which("claude")
    if not claude:
        server.shutdown()
        die("没找到 claude；先装官方 Claude Code")
    override = {
        "env": {
            "ANTHROPIC_BASE_URL": f"http://127.0.0.1:{port}",
            # 全局设 1 是为了让直接 claude 稳定；run 默认把它改回 0 重新开 thinking，
            # 由代理给 Go 网关缺失的 thinking 块补 signature。
            "CLAUDE_CODE_DISABLE_THINKING": "1" if getattr(args, "no_thinking", False) else "0",
        },
        # 明确禁止换模型：DeepSeek 的 thinking 会话混入别的模型的回合后，
        # 下个回合会被 "thinking must be passed back" 拒绝
        "fallbackModel": [],
    }
    override_json = json.dumps(override)
    cmd = [claude, "--settings", override_json, *args.args]
    print(
        f"proxy   : http://127.0.0.1:{port} -> {upstream}   "
        f"(retries={args.retries}, log={PROXY_LOG})",
        file=sys.stderr,
    )
    try:
        rc = subprocess.call(cmd)
    except KeyboardInterrupt:
        rc = 130
    finally:
        server.shutdown()
        server.server_close()
    return rc


def discover_models(base_url: str, token: str):
    """尝试几个常见模型列表端点，返回 [{id,name,context}]。"""
    base = base_url.rstrip("/")
    origin = re.sub(r"^(https?://[^/]+).*", r"\1", base)
    candidates = [f"{base}/v1/models", f"{origin}/v1/models", f"{origin}/models"]
    tried = []
    for url in dict.fromkeys(candidates):
        status, body = http_json(url, token)
        tried.append((url, status))
        if status != 200:
            continue
        try:
            doc = json.loads(body)
        except json.JSONDecodeError:
            continue
        rows = []
        for item in doc.get("data") or []:
            if not isinstance(item, dict) or not item.get("id"):
                continue
            rows.append(
                {
                    "id": item["id"],
                    "name": item.get("display_name") or item.get("name") or item["id"],
                    "context": item.get("context_window") or item.get("context_length"),
                }
            )
        if rows:
            return rows, url, tried
    return [], None, tried


def guess_behaves_as(model_id: str, label: str = "") -> str:
    s = f"{model_id} {label}".lower()
    if "opus" in s:
        return "claude-opus-5-5"
    stripped = s.replace("gemini", "").replace("minimax", "")
    if any(k in stripped for k in ("haiku", "flash", "nano", "mini", "tiny", "fast")):
        return "claude-haiku-5-5"
    return "claude-sonnet-5-5"


def fmt_ctx(n) -> "str | None":
    if not n:
        return None
    n = int(n)
    return f"{round(n / 1e6, 1):g}M ctx" if n >= 1_000_000 else f"{round(n / 1000):g}K ctx"


def picker_row(model_id: str, label: str = None, description: str = None, behaves_as: str = None) -> dict:
    row = {"model": model_id}
    if label and label != model_id:
        row["label"] = label
    if description:
        row["description"] = description
    row["behavesAs"] = behaves_as or guess_behaves_as(model_id, label or "")
    return row


def parse_picker_arg(text: str) -> dict:
    """`id`、`id:label` 或 `id:label:description`。"""
    parts = text.split(":", 2)
    return picker_row(parts[0].strip(), *(p.strip() for p in parts[1:]))


# ------------------------------------------------------------------- commands
def cmd_list(args) -> int:
    cols = profiles()
    if not cols:
        print("（还没有任何档案）用 `patch-claude-code add ...` 新建一个")
        return 0
    cur = active_profile()
    for name, path in cols.items():
        prof = load_json(path, {}) or {}
        base = (prof.get("env") or {}).get("ANTHROPIC_BASE_URL", "?")
        mark = "*" if name == cur else " "
        rows = len((prof.get("modelPicker") or {}).get("options") or [])
        flag = "  [blocked]" if profile_blocked(prof) else ""
        print(f"{mark} {name:16s} {base:52s} {rows:2d} rows  {prof.get('label', '')}{flag}")
    if cur is None:
        print("\n(当前 settings.json 不对应任何档案)")
    return 0


def cmd_current(args) -> int:
    cur = active_profile()
    if cur is None:
        settings = load_json(SETTINGS, {}) or {}
        base = (settings.get("env") or {}).get("ANTHROPIC_BASE_URL")
        print(f"未托管（{base or '没有 ANTHROPIC_BASE_URL'}）")
        return 0
    prof = load_profile(cur)
    print(cur)
    print_summary(
        {
            "profile": cur,
            "label": prof.get("label", ""),
            "base_url": _effective_base(prof),
            "upstream": _upstream_of(prof),
            "proxy": (prof.get("proxy") or {}).get("port"),
            "default_model": prof.get("model"),
            "opus": (prof.get("env") or {}).get("ANTHROPIC_DEFAULT_OPUS_MODEL"),
            "sonnet": (prof.get("env") or {}).get("ANTHROPIC_DEFAULT_SONNET_MODEL"),
            "haiku": (prof.get("env") or {}).get("ANTHROPIC_DEFAULT_HAIKU_MODEL"),
            "max_context": (prof.get("env") or {}).get("CLAUDE_CODE_MAX_CONTEXT_TOKENS"),
            "picker_rows": len((prof.get("modelPicker") or {}).get("options") or []),
            "replace_builtin": (prof.get("modelPicker") or {}).get("replaceBuiltInOptions"),
            "fallback": prof.get("fallbackModel") or [],
        }
    )
    return 0


def resolve_env(name: str, key: str):
    return (load_profile(name).get("env") or {}).get(key)


def cmd_use(args) -> int:
    prof = load_profile(args.name)
    blocked = profile_blocked(prof)
    if blocked:
        print(f"warning: {blocked}")
        print("         切过去之后选这些模型会 403；要试就试，随时 `use minimax-cn` 切回来")
    apply_profile(args.name, dry_run=args.dry_run)
    return 0


def cmd_repair(args) -> int:
    cur = active_profile()
    if cur is None:
        die("当前 settings.json 里没有可识别的档案，用 `use <name>` 直接指定")
    print(f"re-patching {cur}")
    apply_profile(cur, dry_run=args.dry_run)
    return 0


def cmd_unpatch(args) -> int:
    """移除补丁：删掉托管的 env 键、modelPicker 和 fallbackModel，其余设置原样保留。"""
    settings = load_json(SETTINGS, {}) or {}
    env = settings.get("env") or {}
    removed = [k for k in MANAGED_ENV if k in env]
    had_picker = "modelPicker" in settings
    had_fallback = "fallbackModel" in settings
    for k in removed:
        env.pop(k, None)
    settings.pop("modelPicker", None)
    settings.pop("fallbackModel", None)
    print(
        "将要移除:",
        ", ".join(removed) or "(无 env 键)",
        "+ modelPicker" if had_picker else "",
        "+ fallbackModel" if had_fallback else "",
    )
    if not removed and not had_picker and not had_fallback:
        print("(settings.json 已经是干净的)")
        return 0
    if args.dry_run:
        print("dry-run: 未写入")
        return 0
    backup = backup_settings()
    save_json(SETTINGS, settings)
    print(f"unpatched; backup: {backup}")
    print("提示: Claude Code 会回到内置 Anthropic 端点/官方登录")
    return 0


SECRET_SHAPE = re.compile(
    r"^(?:oc_sk_|sk-|ark-|hf_|ghp_|gho_|gsk_|xox[abps]-|AIza)[A-Za-z0-9_.\-]{6,}$", re.I
)


def looks_like_secret(value: str) -> bool:
    """用户习惯性写 --auth-var $FOO，shell 把 $FOO 展开成 key 的值，这里认出来。"""
    if not value:
        return False
    if SECRET_SHAPE.match(value):
        return True
    return bool(re.fullmatch(r"[A-Za-z0-9_.+/=\-]{40,}", value))


def profile_blocked(prof: dict) -> "str | None":
    """档案自带 blocked 说明，或它的 base_url 正好是某个 blocked 预设。"""
    if prof.get("blocked"):
        return prof["blocked"]
    base = (prof.get("env") or {}).get("ANTHROPIC_BASE_URL")
    for preset in PRESETS.values():
        if preset.get("blocked") and preset.get("base_url") == base:
            return preset["blocked"]
    return None


def resolve_auth_input(args):
    """--auth-token / --auth-env / --auth-var 统一解析成 (token, kind, name)。"""
    if hasattr(args, "auth_var") and args.auth_var is None:
        die(
            "--auth-var 后面没有值：如果写的是 $FOO，说明这个变量在 shell 里是空的。\n"
            "      变量名不带 $：--auth-var OPENCODE_GO_APIKEY（或 --auth-env 从环境读、--auth-token 直接给值）"
        )
    name = getattr(args, "auth_var", None)
    if args.auth_token:
        return args.auth_token, "token", None
    if args.auth_env:
        token = os.environ.get(args.auth_env)
        if not token:
            die(
                f"环境变量 ${args.auth_env} 当前是空的。\n"
                f"      先 export {args.auth_env}=...，或改成 --auth-var {args.auth_env}"
            )
        return token, "env", args.auth_env
    if not name:
        die(
            "需要指定 key 来源：\n"
            "      --auth-var <变量名>   例如 --auth-var OPENCODE_GO_APIKEY（不带 $）\n"
            "      --auth-env <变量名>   从当前 shell 环境读\n"
            "      --auth-token <key>    直接给值（会落盘，权限 600）"
        )
    if looks_like_secret(name):
        print(f"warning: --auth-var 收到的是 key 的值（{mask(name)}），不是变量名。")
        print("         这次按 --auth-token 处理；想只存变量名，写成 --auth-var OPENCODE_GO_APIKEY（去掉 $）")
        return name, "token", None
    token = zshrc_var(name)
    if token:
        return token, "var", name
    token = os.environ.get(name)
    if token:
        return token, "env", name
    die(
        f"在 ~/.zshrc 和当前环境里都没有 ${name}。\n"
        f"      变量名不带 $：--auth-var {name}\n"
        f"      或者直接给值：--auth-token <key>"
    )


def cmd_presets(args) -> int:
    for name, preset in PRESETS.items():
        rows = len(preset.get("picker") or [])
        key = f"${preset['auth_var']}" if preset.get("auth_var") else "(local token)"
        print(f"{name:14s} {preset['base_url']:46s} {key:<20s} {rows} rows")
        print(f"{'':14s} {preset['label']}")
        if preset.get("fallback"):
            print(f"{'':14s} fallback: {', '.join(preset['fallback'])}")
        if preset.get("blocked"):
            print(f"{'':14s} x {preset['blocked']}")
        if preset.get("note"):
            print(f"{'':14s} ! {preset['note']}")
    print("\n用法: patch-claude-code setup --preset <name>   (也可以直接 `add` 自建)")
    return 0


def _resolve_key(args, default_var: str):
    """key 优先级: --key > ~/.zshrc 变量 > 同名环境变量 > 交互输入。"""
    if args.key:
        return args.key, "--key", None
    if hasattr(args, "key_var") and args.key_var is None:
        die(
            "--key-var 后面没有值：如果写的是 $FOO，说明这个变量在当前 shell 里没设置/没 export。\n"
            "      变量名不带 $，例如 --key-var OPENCODE_GO_APIKEY；不知道变量名就别写，脚本会用预设里的"
        )
    explicit = getattr(args, "key_var", None)
    if explicit and looks_like_secret(explicit):
        print(f"warning: --key-var 收到的是 key 的值（{mask(explicit)}），不是变量名；按 --key 处理")
        return explicit, "手动输入", None
    var = explicit or default_var
    token = zshrc_var(var) if var else None
    if token:
        return token, f"~/.zshrc 的 ${var}", var
    token = os.environ.get(var) if var else None
    if token:
        return token, f"环境变量 ${var}", var
    if sys.stdin.isatty():
        import getpass

        try:
            entered = getpass.getpass(f"粘贴 ${var} 的 key（不回显）: ").strip()
        except (EOFError, KeyboardInterrupt):
            die("已取消")
        if entered:
            return entered, "手动输入", None
    die(
        f"取不到 key：在 ~/.zshrc 里 export {var}=...，或加 --key/--key-var {var}（变量名不带 $）"
    )


def cmd_setup(args) -> int:
    """一键：挑预置网关 -> 建档案 -> 激活 -> 探活。"""
    if not args.preset:
        if not sys.stdin.isatty():
            die("非交互环境请用 --preset；可选: " + ", ".join(PRESETS))
        for i, (nm, pr) in enumerate(PRESETS.items(), 1):
            print(f"  {i}. {nm:14s} {pr['label']}")
        chosen = input("选择预置网关 [1]: ").strip() or "1"
        args.preset = list(PRESETS)[int(chosen) - 1] if chosen.isdigit() and 1 <= int(chosen) <= len(PRESETS) else chosen
    preset = PRESETS.get(args.preset)
    if preset is None:
        die(f"没有预设 {args.preset!r}；可选: {', '.join(PRESETS)}，或 `add` 自建")

    blocked = preset.get("blocked")
    if blocked:
        print(f"warning  : {blocked}")
        print("           这个预设只写档案、不激活；换成 --preset minimax-cn / deepseek 才能真的用")

    name = args.name or args.preset
    if profile_path(name).exists() and not args.force:
        die(f"档案 {name!r} 已存在（用 --force 覆盖，或 --name 换个名字）")

    claude_bin = shutil.which("claude")
    if claude_bin:
        print(f"claude   : {claude_bin}")
    else:
        print("claude   : 没找到！先装官方 Claude Code：")
        print("           npm i -g @anthropic-ai/claude-code   （或官方原生安装包）")
        if not args.force:
            die("装上后再跑一次；确实要先写配置可以加 --force")

    if preset.get("auth_token"):
        token, src, var = preset["auth_token"], "预设内置的本地 token", None
    else:
        token, src, var = _resolve_key(args, preset.get("auth_var"))
    print(f"gateway  : {preset['base_url']}")
    print(f"key      : {mask(token)}  ({src})")

    options = []
    for spec in preset["picker"]:
        mid = spec[0]
        label = spec[1] if len(spec) > 1 else None
        desc = spec[2] if len(spec) > 2 else None
        options.append(picker_row(mid, label, desc))

    if args.discover:
        rows, used, tried = discover_models(preset["base_url"], token)
        for url, status in tried:
            print(f"  probe {status or 'ERR':>3}  {url}")
        if rows:
            print(f"discovered {len(rows)} models via {used}")
            options = [picker_row(r["id"], r["name"], fmt_ctx(r.get("context"))) for r in rows]
        else:
            print("discovery 没拿到列表，退回预置 picker 行")

    prof = {
        "label": preset["label"],
        "env": {
            "ANTHROPIC_BASE_URL": preset["base_url"],
            "ANTHROPIC_DEFAULT_OPUS_MODEL": preset["opus"],
            "ANTHROPIC_DEFAULT_SONNET_MODEL": preset["sonnet"],
            "ANTHROPIC_DEFAULT_HAIKU_MODEL": preset["haiku"],
            "CLAUDE_CODE_MAX_CONTEXT_TOKENS": str(preset["max_context"]),
            "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
            **({"CLAUDE_CODE_DISABLE_THINKING": "1"} if preset.get("disable_thinking") and not args.thinking else {}),
        },
        "model": "sonnet",
        "modelPicker": {"options": options, "replaceBuiltInOptions": not args.keep_builtin},
    }
    if preset.get("fallback"):
        prof["fallbackModel"] = list(preset["fallback"])
    if blocked:
        prof["blocked"] = blocked
    if var:
        prof["auth_var"] = var          # 只存变量名，key 留在 ~/.zshrc / 环境
    else:
        prof["auth_token"] = token      # 手动输入的 key 只能落盘；下面收紧权限
    path = save_profile(name, prof)
    if "auth_token" in prof:
        path.chmod(0o600)
        print(f"profile  : {path}  (含 key，权限已设为 600，别提交到 git)")
    else:
        print(f"profile  : {path}  (只存变量名 ${prof['auth_var']})")

    if args.no_activate:
        print(f"未激活；之后用 `patch-claude-code use {name}` 生效")
    elif blocked and not args.force:
        print(f"未激活（blocked 预设不会自动改 settings.json；真要激活：use {name}）")
    else:
        apply_profile(name)

    result = 0
    if not args.no_verify:
        result = cmd_verify(argparse.Namespace(name=name, model=None))
    print("\n下一步: 重开一个 claude 会话，用 /model 选模型（alt+p 也能打开选择器）")
    return result


def cmd_link(args) -> int:
    src = Path(__file__).resolve()
    dest_dir = Path(args.dir).expanduser()
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / "patch-claude-code"
    if dest.is_symlink() and dest.resolve() == src:
        print(f"已经链好了: {dest} -> {src}")
    else:
        if dest.exists() or dest.is_symlink():
            if not args.force:
                die(f"{dest} 已存在且不是指向本脚本；加 --force 覆盖")
            dest.unlink()
        dest.symlink_to(src)
        print(f"linked: {dest} -> {src}")
    if str(dest_dir) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f"提示: {dest_dir} 不在 PATH 里，把它加进 shell rc 才能直接 `patch-claude-code`")
    return 0


def cmd_show(args) -> int:
    prof = load_profile(args.name)
    shown = json.loads(json.dumps(prof))
    token, src = resolve_auth(prof, strict=False)
    shown["_resolved_auth"] = f"{mask(token or '')}  ({src})"
    print(json.dumps(shown, indent=2, ensure_ascii=False))
    return 0


def cmd_verify(args) -> int:
    name = args.name or active_profile()
    if not name:
        die("没有生效档案，请指定名字")
    prof = load_profile(name)
    token, src = resolve_auth(prof)
    base = _upstream_of(prof).rstrip("/")
    model = args.model or (prof.get("env") or {}).get("ANTHROPIC_DEFAULT_SONNET_MODEL")
    if not model:
        die("档案里没有 sonnet 模型，用 --model 指定")
    print(f"profile : {name} ({src})")
    print(f"endpoint: {base}/v1/messages  (直连上游，不经过本地代理)")
    print(f"model   : {model}")
    # OpenCode Go 现在要求带会话头才路由；Claude Code 自己会发，探活这里补一个。
    session = None
    if "opencode.ai" in base:
        session = f"patch-claude-code-verify-{int(time.time())}"
    status, body = http_json(
        f"{base}/v1/messages",
        token,
        {"model": model, "max_tokens": 16, "messages": [{"role": "user", "content": "say ok"}]},
        timeout=60,
        session=session,
    )
    ok = status == 200 and '"content"' in body
    print(f"status  : {status}  {'OK' if ok else 'FAIL'}")
    print(f"body    : {body[:300].replace(chr(10), ' ')}")
    if not ok:
        hint = {
            401: "认证失败：key 无效或 auth_var 指向错变量",
            402: "余额/套餐问题（不是配置问题）",
            403: "权限不足或地区限制",
            404: "base_url 路径不对（一般要带 /anthropic）",
        }.get(status)
        if "ModelProtocolUnsupported" in body:
            hint = "该模型不支持 Anthropic 协议（只能走 OpenAI 协议），Claude Code 用不了"
        elif "ModelDeprecated" in body:
            hint = "该模型已下架"
        elif "MissingSessionID" in body:
            hint = "网关要求 x-opencode-session；Claude Code 会自己发，命令行探活已补发，请升级到带会话头的版本"
        elif re.fullmatch(r'\s*\{\s*"model"\s*:\s*"[^"]+"\s*\}\s*', body):
            hint = (
                "网关把上游 400 的正文吞掉了，只回 model id（OpenCode Go 已知问题）——"
                "重试通常能过；已在档案里配 fallbackModel 的会自动切换，不用手动改配置"
            )
        if hint:
            print(f"hint    : {hint}")
    return 0 if ok else 1


def cmd_models(args) -> int:
    prof = load_profile(args.name)
    token, src = resolve_auth(prof)
    base = (prof.get("env") or {}).get("ANTHROPIC_BASE_URL", "")
    rows, used, tried = discover_models(base, token)
    for url, status in tried:
        print(f"  probe {status or 'ERR':>3}  {url}")
    if not rows:
        die("这个网关没有可用的模型列表端点（opencode 的 /v1/models 是 404）")
    print(f"\n{len(rows)} models via {used}  ({src})")
    for r in rows:
        print(f"  {r['id']:32s} {r['name']:28s} {fmt_ctx(r.get('context')) or ''}")
    if args.apply:
        existing = {row["model"]: row for row in (prof.get("modelPicker") or {}).get("options") or []}
        options = []
        for r in rows:
            row = existing.get(r["id"]) or picker_row(r["id"], r["name"], fmt_ctx(r.get("context")))
            options.append(row)
        prof.setdefault("modelPicker", {})["options"] = options
        prof["modelPicker"].setdefault("replaceBuiltInOptions", True)
        save_profile(args.name, prof)
        print(f"\n已写回 {len(options)} 行到档案 {args.name}；如需生效运行 `patch-claude-code use {args.name}`")
    return 0


def parse_model_list(values) -> "list[str]":
    """`--fallback a,b --fallback c` → ["a","b","c"]（去重、最多 3 个）。"""
    out = []
    for chunk in values or []:
        for item in chunk.split(","):
            item = item.strip()
            if item and item not in out:
                out.append(item)
    return out[:3]


def cmd_add(args) -> int:
    name = args.name
    if profile_path(name).exists() and not args.force:
        extra = ""
        if name in PRESETS:
            extra = f"\n       {name!r} 是内置预设，其实不用 add：patch-claude-code setup --preset {name}"
        die(f"档案 {name!r} 已存在（用 --force 覆盖，或换个名字）{extra}")
    if not re.match(r"^https?://", args.base_url):
        die("--base-url 必须以 http(s):// 开头")

    token, auth_kind, auth_name = resolve_auth_input(args)

    rows = []
    if args.discover:
        discovered, used, tried = discover_models(args.base_url, token)
        for url, status in tried:
            print(f"  probe {status or 'ERR':>3}  {url}")
        if not discovered:
            print("warning: 发现失败，继续用给定参数")
        else:
            print(f"discovered {len(discovered)} models via {used}")
            rows = [picker_row(r["id"], r["name"], fmt_ctx(r.get("context"))) for r in discovered]

    for spec in args.picker or []:
        rows.append(parse_picker_arg(spec))

    sonnet = args.sonnet or (rows[0]["model"] if rows else None)
    haiku = args.haiku or sonnet
    opus = args.opus or sonnet
    if not sonnet:
        die("没有模型：用 --sonnet/--opus/--haiku 或 --discover/--picker")

    if not rows:
        rows = [picker_row(sonnet)]

    env = {
        "ANTHROPIC_BASE_URL": args.base_url.rstrip("/"),
        "ANTHROPIC_DEFAULT_OPUS_MODEL": opus,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": sonnet,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": haiku,
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": str(args.max_context),
    }
    if not args.allow_betas:
        env["CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS"] = "1"
    if args.no_thinking:
        env["CLAUDE_CODE_DISABLE_THINKING"] = "1"

    prof = {
        "label": args.label or name,
        "env": env,
        "model": args.model,
        "modelPicker": {
            "options": rows,
            "replaceBuiltInOptions": not args.keep_builtin,
        },
    }
    fallback = parse_model_list(args.fallback)
    if fallback:
        prof["fallbackModel"] = fallback
    if auth_kind == "var":
        prof["auth_var"] = auth_name
    elif auth_kind == "env":
        prof["auth_env"] = auth_name
    else:
        prof["auth_token"] = token
        print("warning: key 以明文写进档案（权限已设 600）；更推荐 --auth-var <变量名>")

    path = save_profile(name, prof)
    if "auth_token" in prof:
        path.chmod(0o600)
    print(f"created {path}")
    print(f"models  : opus={opus} sonnet={sonnet} haiku={haiku}")
    print(f"picker  : {len(rows)} rows, replaceBuiltInOptions={not args.keep_builtin}")
    if fallback:
        print(f"fallback: {', '.join(fallback)}")

    if args.verify:
        ns = argparse.Namespace(name=name, model=None)
        if cmd_verify(ns) != 0:
            die("探活失败，档案已保留，但没有激活")
    if args.activate:
        apply_profile(name)
    return 0


def cmd_remove(args) -> int:
    path = profiles().get(args.name)
    if not path:
        die(f"没有档案 {args.name!r}")
    if active_profile() == args.name and not args.force:
        die(f"{args.name} 正在生效；先 `use` 别的档案，或加 --force")
    path.unlink()
    print(f"removed {path}")
    return 0


def cmd_backups(args) -> int:
    if not BACKUP_DIR.is_dir():
        print("（没有备份）")
        return 0
    items = sorted(BACKUP_DIR.glob("settings.json.*"))
    if not items:
        print("（没有备份）")
        return 0
    for p in items[-args.limit :]:
        print(f"  {p.name}  {time.strftime('%Y-%m-%d %H:%M', time.localtime(p.stat().st_mtime))}")
    return 0


def cmd_revert(args) -> int:
    if args.backup:
        src = Path(args.backup).expanduser()
        if not src.exists():
            src = BACKUP_DIR / args.backup
        if not src.exists():
            die(f"找不到备份 {args.backup}")
    else:
        items = sorted(BACKUP_DIR.glob("settings.json.*")) if BACKUP_DIR.is_dir() else []
        if not items:
            die("没有可回滚的备份")
        src = items[-1]
    cur = active_profile()
    backup_settings()
    shutil.copy2(src, SETTINGS)
    print(f"restored {src.name} -> {SETTINGS}")
    if cur:
        print(f"(该备份可能属于别的档案；当前生效: {active_profile() or '未托管'})")
    return 0


# ----------------------------------------------------------------------- main
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="patch-claude-code",
        description="管理 Claude Code 的 provider 补丁（env + model + modelPicker）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("list", help="列出档案")
    s.set_defaults(func=cmd_list)
    s = sub.add_parser("current", help="当前生效档案")
    s.set_defaults(func=cmd_current)
    s = sub.add_parser("backups", help="列出备份")
    s.add_argument("--limit", type=int, default=10)
    s.set_defaults(func=cmd_backups)

    s = sub.add_parser("use", help="切换档案")
    s.add_argument("name")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_use)
    s = sub.add_parser("apply", help="同 use")
    s.add_argument("name")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_use)

    s = sub.add_parser("repair", help="按当前档案重打补丁")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_repair)

    s = sub.add_parser("unpatch", help="移除补丁（回到官方端点）")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_unpatch)

    s = sub.add_parser("show", help="打印档案（key 打码）")
    s.add_argument("name")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("verify", help="探活（真发一次 /v1/messages）")
    s.add_argument("name", nargs="?")
    s.add_argument("--model")
    s.set_defaults(func=cmd_verify)

    s = sub.add_parser("models", help="从网关发现模型")
    s.add_argument("name")
    s.add_argument("--apply", action="store_true", help="写回 modelPicker")
    s.set_defaults(func=cmd_models)

    s = sub.add_parser("revert", help="回滚备份")
    s.add_argument("--backup")
    s.set_defaults(func=cmd_revert)

    s = sub.add_parser("daemon", help="把签名/重试代理装成 launchd 常驻服务（macOS）")
    s.add_argument("action", choices=("install", "uninstall", "status"))
    s.add_argument("--profile")
    s.add_argument("--port", type=int, default=8790)
    s.add_argument("--retries", type=int, default=4)
    s.set_defaults(func=cmd_daemon)

    s = sub.add_parser("proxy", help="本地重试代理（前台）：吃掉偶发的 400/model 错误")
    s.add_argument("--profile")
    s.add_argument("--upstream", help="直接指定真实网关地址（默认取档案的 base_url）")
    s.add_argument("--port", type=int, default=8790)
    s.add_argument("--retries", type=int, default=4)
    s.set_defaults(func=cmd_proxy)

    s = sub.add_parser("remove", help="删除档案")
    s.add_argument("name")
    s.add_argument("--force", action="store_true")
    s.set_defaults(func=cmd_remove)

    s = sub.add_parser("presets", help="列出内置网关预设")
    s.set_defaults(func=cmd_presets)

    s = sub.add_parser("setup", help="一键：建档案 + 激活 + 探活")
    s.add_argument("--preset", help="预置网关名（见 `presets`）")
    s.add_argument("--name", help="档案名（默认同 preset）")
    s.add_argument("--key", help="直接给 key（不推荐，会落盘）")
    s.add_argument(
        "--key-var",
        nargs="?",
        metavar="VAR",
        default=argparse.SUPPRESS,
        help="key 所在变量名，不带 $（默认用预设里的）",
    )
    s.add_argument("--discover", action="store_true", help="从网关拉模型列表生成 picker")
    s.add_argument("--keep-builtin", action="store_true", help="保留内置 Opus/Sonnet/Haiku 行")
    s.add_argument("--thinking", action="store_true", help="保留扩展思考（DeepSeek 可能报 thinking must be passed back）")
    s.add_argument("--no-activate", action="store_true", help="只建档案，不写入 settings.json")
    s.add_argument("--no-verify", action="store_true", help="跳过探活")
    s.add_argument("--force", action="store_true", help="覆盖同名档案 / 忽略 claude 未安装")
    s.set_defaults(func=cmd_setup)

    s = sub.add_parser("link", help="把自己链到 PATH 目录")
    s.add_argument("--dir", default=str(Path.home() / ".local" / "bin"))
    s.add_argument("--force", action="store_true")
    s.set_defaults(func=cmd_link)

    s = sub.add_parser("add", help="新建 provider 档案")
    s.add_argument("name")
    s.add_argument("--base-url", required=True, help="Anthropic 协议端点，如 https://api.deepseek.com/anthropic")
    s.add_argument(
        "--auth-var",
        nargs="?",
        metavar="VAR",
        default=argparse.SUPPRESS,
        help="变量名，不带 $（推荐），例如 OPENCODE_GO_APIKEY",
    )
    s.add_argument("--auth-env", help="从当前进程环境变量读")
    s.add_argument("--auth-token", help="直接给明文 key（不推荐）")
    s.add_argument("--label")
    s.add_argument("--opus")
    s.add_argument("--sonnet")
    s.add_argument("--haiku")
    s.add_argument("--model", default="sonnet", help="settings.model 默认别名（sonnet/opus/default）")
    s.add_argument("--max-context", type=int, default=1_000_000)
    s.add_argument("--picker", action="append", metavar="ID[:LABEL[:DESC]]")
    s.add_argument(
        "--fallback",
        action="append",
        metavar="MODEL[,MODEL]",
        help="主模型失败时自动切换的备用模型（最多 3 个，如 minimax-m3,qwen3.8-flash）",
    )
    s.add_argument("--discover", action="store_true", help="自动发现模型并生成 picker 行")
    s.add_argument("--keep-builtin", action="store_true", help="保留内置 Opus/Sonnet/Haiku 行")
    s.add_argument("--allow-betas", action="store_true", help="不设 CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS")
    s.add_argument("--no-thinking", action="store_true", help="设 CLAUDE_CODE_DISABLE_THINKING=1（DeepSeek 建议）")
    s.add_argument("--verify", action="store_true", help="创建后立即探活")
    s.add_argument("--activate", action="store_true", help="创建后立即生效")
    s.add_argument("--force", action="store_true", help="覆盖同名档案")
    s.set_defaults(func=cmd_add)
    return p


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "run":
        profile = None
        upstream = None
        port = 0
        retries = 4
        no_thinking = False
        i = 1
        while i < len(argv):
            a = argv[i]
            if a == "--":
                i += 1
                break
            if a in ("-h", "--help"):
                print(
                    "usage: patch-claude-code run [--profile NAME] [--upstream URL] [--port N] [--retries N] [--no-thinking] [--] <claude args>\n"
                    "起一个只活到本次 Claude Code 退出的本地重试代理：\n"
                    "偶发 400 {\"model\":...}（Go 网关吞掉上游正文）时自动重试并换会话 id。\n"
                    "默认重新开启 thinking（代理补 signature），--no-thinking 关闭；\n"
                    "本会话固定清空 fallbackModel：重试仍失败就报错，绝不换模型。\n"
                    "例: patch-claude-code run --profile opencode-go -p \"say ok\"\n"
                    "    patch-claude-code run --profile opencode-go"
                )
                return 0
            if a == "--profile" and i + 1 < len(argv):
                profile = argv[i + 1]; i += 2; continue
            if a.startswith("--profile="):
                profile = a.split("=", 1)[1]; i += 1; continue
            if a == "--upstream" and i + 1 < len(argv):
                upstream = argv[i + 1]; i += 2; continue
            if a.startswith("--upstream="):
                upstream = a.split("=", 1)[1]; i += 1; continue
            if a == "--port" and i + 1 < len(argv):
                port = int(argv[i + 1]); i += 2; continue
            if a.startswith("--port="):
                port = int(a.split("=", 1)[1]); i += 1; continue
            if a == "--retries" and i + 1 < len(argv):
                retries = int(argv[i + 1]); i += 2; continue
            if a.startswith("--retries="):
                retries = int(a.split("=", 1)[1]); i += 1; continue
            if a == "--no-thinking":
                no_thinking = True; i += 1; continue
            break
        return cmd_run(argparse.Namespace(profile=profile, upstream=upstream, port=port, retries=retries, no_thinking=no_thinking, args=argv[i:]))
    parser = build_parser()
    # 兼容旧用法: patch-claude-code <profile>  ==  use <profile>
    known = {"list", "current", "backups", "use", "apply", "repair", "show", "unpatch",
             "verify", "models", "revert", "remove", "add", "presets", "setup", "link",
             "proxy", "daemon", "-h", "--help"}
    if argv and argv[0] not in known and argv[0] in profiles():
        argv = ["use", *argv]
    args = parser.parse_args(argv)
    if not args.cmd:
        parser.print_help()
        cur = active_profile()
        print(f"\n当前生效: {cur or '未托管'}")
        return 0
    return args.func(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
