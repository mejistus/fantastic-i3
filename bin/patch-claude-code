# --------------------------------------------------------------------------- io
def die(msg: str, code: int = 1) -> "None":
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def load_json(path: Path, default=None):
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        die(f"{path} 不是合法 JSON: {exc}")


def save_json(path: Path, obj) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.replace(path)


def mask(secret: str) -> str:
    if not secret:
        return ""
    return secret[:7] + "…" + secret[-4:] if len(secret) > 14 else secret[:3] + "…"


def zshrc_var(name: str):
    """读 ~/.zshrc 里 `export NAME=...` 的值（含引号/无引号两种写法）。"""
    rc = Path.home() / ".zshrc"
    if not name or not rc.exists():
        return None
    text = rc.read_text(encoding="utf-8", errors="replace")
    m = re.search(
        r"^[ \t]*(?:export[ \t]+)?" + re.escape(name) + r"[ \t]*=[ \t]*(['\"]?)([^'\"\n#]+)\1",
        text,
        re.M,
    )
    return m.group(2).strip() if m else None


# ------------------------------------------------------------------- profiles
def profile_path(name: str) -> Path:
    if not NAME_RE.match(name):
        die(f"档案名只允许字母数字 . _ -（收到 {name!r}）")
    return PROFILE_DIR / f"{name}.json"


def profiles() -> "dict[str, Path]":
    if not PROFILE_DIR.is_dir():
        return {}
    return {p.stem: p for p in sorted(PROFILE_DIR.glob("*.json"))}


def load_profile(name: str) -> dict:
    path = profiles().get(name)
    if path is None:
        available = ", ".join(profiles()) or "(空)"
        die(f"没有档案 {name!r}；可用: {available}")
    prof = load_json(path, {})
    prof.setdefault("env", {})
    return prof


def save_profile(name: str, prof: dict) -> Path:
    path = profile_path(name)
    save_json(path, prof)
    return path


def resolve_auth(prof: dict, strict: bool = True):
    """返回 (token, 来源说明)。"""
    name = prof.get("auth_var")
    if name:
        token = zshrc_var(name)
        if token:
            return token, f"~/.zshrc 的 ${name}"
        if strict:
            die(f"档案引用的 shell 变量 ${name} 在 ~/.zshrc 里找不到")
        return None, f"${name}(缺失)"
    if prof.get("auth_env"):
        name = prof["auth_env"]
        token = os.environ.get(name)
        if token:
            return token, f"环境变量 ${name}"
        if strict:
            die(f"环境变量 ${name} 为空")
        return None, f"${name}(缺失)"
    if prof.get("auth_token"):
        return prof["auth_token"], "档案内明文"
    if strict:
        die("档案里没有 auth_var / auth_env / auth_token")
    return None, "(无)"


def active_profile():
    try:
        settings = load_json(SETTINGS, {}) or {}
    except SystemExit:
        return None
    base = (settings.get("env") or {}).get("ANTHROPIC_BASE_URL")
    if not base:
        return None
    for name, path in profiles().items():
        prof = load_json(path, {}) or {}
        if (prof.get("env") or {}).get("ANTHROPIC_BASE_URL") == base:
            return name
    return None


# ----------------------------------------------------------------- settings
def backup_settings() -> "Path | None":
    if not SETTINGS.exists():
        return None
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    dest = BACKUP_DIR / f"settings.json.{stamp}"
    shutil.copy2(SETTINGS, dest)
    return dest


def build_settings(prof: dict, current: dict) -> dict:
    """把档案合进现有 settings（保留 hooks/statusLine/plugins 等非托管键）。"""
    settings = json.loads(json.dumps(current))  # deep copy
    env = {k: v for k, v in (settings.get("env") or {}).items() if k not in MANAGED_ENV}
    env.update({k: str(v) for k, v in (prof.get("env") or {}).items()})
    token, _ = resolve_auth(prof)
    env["ANTHROPIC_AUTH_TOKEN"] = token
    settings["env"] = dict(sorted(env.items()))
    settings["model"] = prof.get("model", settings.get("model", "sonnet"))
    if prof.get("modelPicker"):
        settings["modelPicker"] = prof["modelPicker"]
    return settings


def apply_profile(name: str, dry_run: bool = False, quiet: bool = False) -> dict:
    prof = load_profile(name)
    current = load_json(SETTINGS, {}) or {}
    settings = build_settings(prof, current)
    resolved = {
        "profile": name,
        "label": prof.get("label", ""),
        "base_url": settings["env"].get("ANTHROPIC_BASE_URL"),
        "default_model": settings.get("model"),
        "opus": settings["env"].get("ANTHROPIC_DEFAULT_OPUS_MODEL"),
        "sonnet": settings["env"].get("ANTHROPIC_DEFAULT_SONNET_MODEL"),
        "haiku": settings["env"].get("ANTHROPIC_DEFAULT_HAIKU_MODEL"),
        "max_context": settings["env"].get("CLAUDE_CODE_MAX_CONTEXT_TOKENS"),
        "picker_rows": len((settings.get("modelPicker") or {}).get("options") or []),
        "replace_builtin": (settings.get("modelPicker") or {}).get("replaceBuiltInOptions"),
    }
    if dry_run:
        resolved["dry_run"] = True
        masked_env = dict(settings["env"])
        if masked_env.get("ANTHROPIC_AUTH_TOKEN"):
            masked_env["ANTHROPIC_AUTH_TOKEN"] = mask(masked_env["ANTHROPIC_AUTH_TOKEN"])
        resolved["settings_preview"] = {
            "env": masked_env,
            "model": settings.get("model"),
            "modelPicker": settings.get("modelPicker"),
        }
        print_summary(resolved)
        print("\nsettings.json 预览 (未写入):")
        print(json.dumps(resolved["settings_preview"], indent=2, ensure_ascii=False)[:1200])
        return resolved
    backup = backup_settings()
    save_json(SETTINGS, settings)
    resolved["backup"] = str(backup) if backup else None
    if not quiet:
        print_summary(resolved)
    return resolved


def print_summary(r: dict) -> None:
    print(f"active profile    : {r['profile']}" + (f"  ({r['label']})" if r.get("label") else ""))
    print(f"ANTHROPIC_BASE_URL: {r['base_url']}")
    print(f"models            : model={r['default_model']}  opus={r['opus']}  sonnet={r['sonnet']}  haiku={r['haiku']}")
    print(f"max context       : {r['max_context']}")
    print(f"picker rows       : {r['picker_rows']}" + ("  (replaceBuiltInOptions=true)" if r["replace_builtin"] else ""))
    if r.get("backup"):
        print(f"backup            : {r['backup']}")


# ------------------------------------------------------------------ discovery
def http_json(url: str, token: str = None, payload: dict = None, timeout: int = 30):
    headers = {"accept": "application/json", "user-agent": "patch-claude-code/1"}
    if token:
        headers["authorization"] = f"Bearer {token}"
    data = None
    if payload is not None:
        headers["content-type"] = "application/json"
        headers["anthropic-version"] = "2023-06-01"
        data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if data else "GET")
    ctx = ssl.create_default_context()
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
            return resp.status, resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode("utf-8", "replace")
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return 0, f"connection failed: {exc}"


def discover_models(base_url: str, token: str):
    """尝试几个常见模型列表端点，返回 [{id,name,context}]。"""
    base = base_url.rstrip("/")
    origin = re.sub(r"^(https?://[^/]+).*", r"\1", base)
    candidates = [f"{base}/v1/models", f"{origin}/v1/models", f"{origin}/models"]
    tried = []
    for url in dict.fromkeys(candidates):
        status, body = http_json(url, token)
        tried.append((url, status))
        if status != 200:
            continue
        try:
            doc = json.loads(body)
        except json.JSONDecodeError:
            continue
        rows = []
        for item in doc.get("data") or []:
            if not isinstance(item, dict) or not item.get("id"):
                continue
            rows.append(
                {
                    "id": item["id"],
                    "name": item.get("display_name") or item.get("name") or item["id"],
                    "context": item.get("context_window") or item.get("context_length"),
                }
            )
        if rows:
            return rows, url, tried
    return [], None, tried


def guess_behaves_as(model_id: str, label: str = "") -> str:
    s = f"{model_id} {label}".lower()
    if "opus" in s:
        return "claude-opus-5-5"
    stripped = s.replace("gemini", "").replace("minimax", "")
    if any(k in stripped for k in ("haiku", "flash", "nano", "mini", "tiny", "fast")):
        return "claude-haiku-5-5"
    return "claude-sonnet-5-5"


def fmt_ctx(n) -> "str | None":
    if not n:
        return None
    n = int(n)
    return f"{round(n / 1e6, 1):g}M ctx" if n >= 1_000_000 else f"{round(n / 1000):g}K ctx"


def picker_row(model_id: str, label: str = None, description: str = None, behaves_as: str = None) -> dict:
    row = {"model": model_id}
    if label and label != model_id:
        row["label"] = label
    if description:
        row["description"] = description
    row["behavesAs"] = behaves_as or guess_behaves_as(model_id, label or "")
    return row


def parse_picker_arg(text: str) -> dict:
    """`id`、`id:label` 或 `id:label:description`。"""
    parts = text.split(":", 2)
    return picker_row(parts[0].strip(), *(p.strip() for p in parts[1:]))


# ------------------------------------------------------------------- commands
def cmd_list(args) -> int:
    cols = profiles()
    if not cols:
        print("（还没有任何档案）用 `patch-claude-code add ...` 新建一个")
        return 0
    cur = active_profile()
    for name, path in cols.items():
        prof = load_json(path, {}) or {}
        base = (prof.get("env") or {}).get("ANTHROPIC_BASE_URL", "?")
        mark = "*" if name == cur else " "
        rows = len((prof.get("modelPicker") or {}).get("options") or [])
        print(f"{mark} {name:16s} {base:52s} {rows:2d} rows  {prof.get('label', '')}")
    if cur is None:
        print("\n(当前 settings.json 不对应任何档案)")
    return 0


def cmd_current(args) -> int:
    cur = active_profile()
    if cur is None:
        settings = load_json(SETTINGS, {}) or {}
        base = (settings.get("env") or {}).get("ANTHROPIC_BASE_URL")
        print(f"未托管（{base or '没有 ANTHROPIC_BASE_URL'}）")
        return 0
    print(cur)
    print_summary(
        {
            "profile": cur,
            "label": load_profile(cur).get("label", ""),
            "base_url": (load_profile(cur).get("env") or {}).get("ANTHROPIC_BASE_URL"),
            "default_model": load_profile(cur).get("model"),
            "opus": resolve_env(cur, "ANTHROPIC_DEFAULT_OPUS_MODEL"),
            "sonnet": resolve_env(cur, "ANTHROPIC_DEFAULT_SONNET_MODEL"),
            "haiku": resolve_env(cur, "ANTHROPIC_DEFAULT_HAIKU_MODEL"),
            "max_context": resolve_env(cur, "CLAUDE_CODE_MAX_CONTEXT_TOKENS"),
            "picker_rows": len((load_profile(cur).get("modelPicker") or {}).get("options") or []),
            "replace_builtin": (load_profile(cur).get("modelPicker") or {}).get("replaceBuiltInOptions"),
        }
    )
    return 0


def resolve_env(name: str, key: str):
    return (load_profile(name).get("env") or {}).get(key)


def cmd_use(args) -> int:
    apply_profile(args.name, dry_run=args.dry_run)
    return 0


def cmd_repair(args) -> int:
    cur = active_profile()
    if cur is None:
        die("当前 settings.json 里没有可识别的档案，用 `use <name>` 直接指定")
    print(f"re-patching {cur}")
    apply_profile(cur, dry_run=args.dry_run)
    return 0


def cmd_unpatch(args) -> int:
    """移除补丁：删掉托管的 env 键和 modelPicker，其余设置原样保留。"""
    settings = load_json(SETTINGS, {}) or {}
    env = settings.get("env") or {}
    removed = [k for k in MANAGED_ENV if k in env]
    had_picker = "modelPicker" in settings
    for k in removed:
        env.pop(k, None)
    settings.pop("modelPicker", None)
    print("将要移除:", ", ".join(removed) or "(无 env 键)", "+ modelPicker" if had_picker else "")
    if not removed and not had_picker:
        print("(settings.json 已经是干净的)")
        return 0
    if args.dry_run:
        print("dry-run: 未写入")
        return 0
    backup = backup_settings()
    save_json(SETTINGS, settings)
    print(f"unpatched; backup: {backup}")
    print("提示: Claude Code 会回到内置 Anthropic 端点/官方登录")
    return 0


def cmd_presets(args) -> int:
    for name, preset in PRESETS.items():
        rows = len(preset.get("picker") or [])
        print(f"{name:14s} {preset['base_url']:46s} ${preset['auth_var']:<20s} {rows} rows")
        print(f"{'':14s} {preset['label']}")
        if preset.get("blocked"):
            print(f"{'':14s} x {preset['blocked']}")
        if preset.get("note"):
            print(f"{'':14s} ! {preset['note']}")
    print("\n用法: patch-claude-code setup --preset <name>   (也可以直接 `add` 自建)")
    return 0


def _resolve_key(args, default_var: str):
    """key 优先级: --key > ~/.zshrc 变量 > 同名环境变量 > 交互输入。"""
    if args.key:
        return args.key, "--key", None
    var = args.key_var or default_var
    token = zshrc_var(var) if var else None
    if token:
        return token, f"~/.zshrc 的 ${var}", var
    token = os.environ.get(var) if var else None
    if token:
        return token, f"环境变量 ${var}", var
    if sys.stdin.isatty():
        import getpass

        try:
            entered = getpass.getpass(f"粘贴 ${var} 的 key（不回显）: ").strip()
        except (EOFError, KeyboardInterrupt):
            die("已取消")
        if entered:
            return entered, "手动输入", None
    die(f"取不到 key：先在 ~/.zshrc 里 export {var}=...，或加 --key/--key-var")


def cmd_setup(args) -> int:
    """一键：挑预置网关 -> 建档案 -> 激活 -> 探活。"""
    if not args.preset:
        if not sys.stdin.isatty():
            die("非交互环境请用 --preset；可选: " + ", ".join(PRESETS))
        for i, (nm, pr) in enumerate(PRESETS.items(), 1):
            print(f"  {i}. {nm:14s} {pr['label']}")
        chosen = input("选择预置网关 [1]: ").strip() or "1"
        args.preset = list(PRESETS)[int(chosen) - 1] if chosen.isdigit() and 1 <= int(chosen) <= len(PRESETS) else chosen
    preset = PRESETS.get(args.preset)
    if preset is None:
        die(f"没有预设 {args.preset!r}；可选: {', '.join(PRESETS)}，或 `add` 自建")

    if preset.get("blocked"):
        print(f"warning  : {preset['blocked']}")
        print("           档案照样能建，但选这些模型会报错；换成 --preset opencode-go / minimax-cn 才能真的用")

    name = args.name or args.preset
    if profile_path(name).exists() and not args.force:
        die(f"档案 {name!r} 已存在（用 --force 覆盖，或 --name 换个名字）")

    claude_bin = shutil.which("claude")
    if claude_bin:
        print(f"claude   : {claude_bin}")
    else:
        print("claude   : 没找到！先装官方 Claude Code：")
        print("           npm i -g @anthropic-ai/claude-code   （或官方原生安装包）")
        if not args.force:
            die("装上后再跑一次；确实要先写配置可以加 --force")

    token, src, var = _resolve_key(args, preset["auth_var"])
    print(f"gateway  : {preset['base_url']}")
    print(f"key      : {mask(token)}  ({src})")

    options = []
    for spec in preset["picker"]:
        mid = spec[0]
        label = spec[1] if len(spec) > 1 else None
        desc = spec[2] if len(spec) > 2 else None
        options.append(picker_row(mid, label, desc))

    if args.discover:
        rows, used, tried = discover_models(preset["base_url"], token)
        for url, status in tried:
            print(f"  probe {status or 'ERR':>3}  {url}")
        if rows:
            print(f"discovered {len(rows)} models via {used}")
            options = [picker_row(r["id"], r["name"], fmt_ctx(r.get("context"))) for r in rows]
        else:
            print("discovery 没拿到列表，退回预置 picker 行")

    prof = {
        "label": preset["label"],
        "env": {
            "ANTHROPIC_BASE_URL": preset["base_url"],
            "ANTHROPIC_DEFAULT_OPUS_MODEL": preset["opus"],
            "ANTHROPIC_DEFAULT_SONNET_MODEL": preset["sonnet"],
            "ANTHROPIC_DEFAULT_HAIKU_MODEL": preset["haiku"],
            "CLAUDE_CODE_MAX_CONTEXT_TOKENS": str(preset["max_context"]),
            "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
        },
        "model": "sonnet",
        "modelPicker": {"options": options, "replaceBuiltInOptions": not args.keep_builtin},
    }
    if var:
        prof["auth_var"] = var          # 只存变量名，key 留在 ~/.zshrc / 环境
    else:
        prof["auth_token"] = token      # 手动输入的 key 只能落盘；下面收紧权限
    path = save_profile(name, prof)
    if "auth_token" in prof:
        path.chmod(0o600)
        print(f"profile  : {path}  (含 key，权限已设为 600，别提交到 git)")
    else:
        print(f"profile  : {path}  (只存变量名 ${prof['auth_var']})")

    if not args.no_activate:
        apply_profile(name)
    else:
        print(f"未激活；之后用 `patch-claude-code use {name}` 生效")

    result = 0
    if not args.no_verify:
        result = cmd_verify(argparse.Namespace(name=name, model=None))
    print("\n下一步: 重开一个 claude 会话，用 /model 选模型（alt+p 也能打开选择器）")
    return result


def cmd_link(args) -> int:
    src = Path(__file__).resolve()
    dest_dir = Path(args.dir).expanduser()
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / "patch-claude-code"
    if dest.is_symlink() and dest.resolve() == src:
        print(f"已经链好了: {dest} -> {src}")
    else:
        if dest.exists() or dest.is_symlink():
            if not args.force:
                die(f"{dest} 已存在且不是指向本脚本；加 --force 覆盖")
            dest.unlink()
        dest.symlink_to(src)
        print(f"linked: {dest} -> {src}")
    if str(dest_dir) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f"提示: {dest_dir} 不在 PATH 里，把它加进 shell rc 才能直接 `patch-claude-code`")
    return 0


def cmd_show(args) -> int:
    prof = load_profile(args.name)
    shown = json.loads(json.dumps(prof))
    token, src = resolve_auth(prof, strict=False)
    shown["_resolved_auth"] = f"{mask(token or '')}  ({src})"
    print(json.dumps(shown, indent=2, ensure_ascii=False))
    return 0


def cmd_verify(args) -> int:
    name = args.name or active_profile()
    if not name:
        die("没有生效档案，请指定名字")
    prof = load_profile(name)
    token, src = resolve_auth(prof)
    base = (prof.get("env") or {}).get("ANTHROPIC_BASE_URL", "").rstrip("/")
    model = args.model or (prof.get("env") or {}).get("ANTHROPIC_DEFAULT_SONNET_MODEL")
    if not model:
        die("档案里没有 sonnet 模型，用 --model 指定")
    print(f"profile : {name} ({src})")
    print(f"endpoint: {base}/v1/messages")
    print(f"model   : {model}")
    status, body = http_json(
        f"{base}/v1/messages",
        token,
        {"model": model, "max_tokens": 16, "messages": [{"role": "user", "content": "say ok"}]},
        timeout=60,
    )
    ok = status == 200 and '"content"' in body
    print(f"status  : {status}  {'OK' if ok else 'FAIL'}")
    print(f"body    : {body[:300].replace(chr(10), ' ')}")
    if not ok:
        hint = {
            401: "认证失败：key 无效或 auth_var 指向错变量",
            402: "余额/套餐问题（不是配置问题）",
            403: "权限不足或地区限制",
            404: "base_url 路径不对（一般要带 /anthropic）",
        }.get(status)
        if "FreeTierError" in body:
            hint = "OpenCode 免费层只能在 OpenCode 客户端里用；这个端点从外部调不通"
        elif "ModelProtocolUnsupported" in body:
            hint = "该模型不支持 Anthropic 协议（只能走 OpenAI 协议），Claude Code 用不了"
        elif "ModelDeprecated" in body:
            hint = "该模型已下架"
        if hint:
            print(f"hint    : {hint}")
    return 0 if ok else 1


def cmd_models(args) -> int:
    prof = load_profile(args.name)
    token, src = resolve_auth(prof)
    base = (prof.get("env") or {}).get("ANTHROPIC_BASE_URL", "")
    rows, used, tried = discover_models(base, token)
    for url, status in tried:
        print(f"  probe {status or 'ERR':>3}  {url}")
    if not rows:
        die("这个网关没有可用的模型列表端点（opencode 的 /v1/models 是 404）")
    print(f"\n{len(rows)} models via {used}  ({src})")
    for r in rows:
        print(f"  {r['id']:32s} {r['name']:28s} {fmt_ctx(r.get('context')) or ''}")
    if args.apply:
        existing = {row["model"]: row for row in (prof.get("modelPicker") or {}).get("options") or []}
        options = []
        for r in rows:
            row = existing.get(r["id"]) or picker_row(r["id"], r["name"], fmt_ctx(r.get("context")))
            options.append(row)
        prof.setdefault("modelPicker", {})["options"] = options
        prof["modelPicker"].setdefault("replaceBuiltInOptions", True)
        save_profile(args.name, prof)
        print(f"\n已写回 {len(options)} 行到档案 {args.name}；如需生效运行 `patch-claude-code use {args.name}`")
    return 0


def cmd_add(args) -> int:
    name = args.name
    if profile_path(name).exists() and not args.force:
        die(f"档案 {name!r} 已存在（用 --force 覆盖）")
    if not re.match(r"^https?://", args.base_url):
        die("--base-url 必须以 http(s):// 开头")

    token = args.auth_token or (os.environ.get(args.auth_env) if args.auth_env else None) or (
        zshrc_var(args.auth_var) if args.auth_var else None
    )
    if not token:
        die("需要 --auth-var / --auth-env / --auth-token 之一，且要能取到值")

    rows = []
    if args.discover:
        discovered, used, tried = discover_models(args.base_url, token)
        for url, status in tried:
            print(f"  probe {status or 'ERR':>3}  {url}")
        if not discovered:
            print("warning: 发现失败，继续用给定参数")
        else:
            print(f"discovered {len(discovered)} models via {used}")
            rows = [picker_row(r["id"], r["name"], fmt_ctx(r.get("context"))) for r in discovered]

    for spec in args.picker or []:
        rows.append(parse_picker_arg(spec))

    sonnet = args.sonnet or (rows[0]["model"] if rows else None)
    haiku = args.haiku or sonnet
    opus = args.opus or sonnet
    if not sonnet:
        die("没有模型：用 --sonnet/--opus/--haiku 或 --discover/--picker")

    if not rows:
        rows = [picker_row(sonnet)]

    env = {
        "ANTHROPIC_BASE_URL": args.base_url.rstrip("/"),
        "ANTHROPIC_DEFAULT_OPUS_MODEL": opus,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": sonnet,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": haiku,
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": str(args.max_context),
    }
    if not args.allow_betas:
        env["CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS"] = "1"

    prof = {
        "label": args.label or name,
        "env": env,
        "model": args.model,
        "modelPicker": {
            "options": rows,
            "replaceBuiltInOptions": not args.keep_builtin,
        },
    }
    if args.auth_token:
        prof["auth_token"] = args.auth_token
        print("warning: key 以明文写进档案；更推荐 --auth-var（存变量名）")
    elif args.auth_var:
        prof["auth_var"] = args.auth_var
    else:
        prof["auth_env"] = args.auth_env

    path = save_profile(name, prof)
    print(f"created {path}")
    print(f"models  : opus={opus} sonnet={sonnet} haiku={haiku}")
    print(f"picker  : {len(rows)} rows, replaceBuiltInOptions={not args.keep_builtin}")

    if args.verify:
        ns = argparse.Namespace(name=name, model=None)
        if cmd_verify(ns) != 0:
            die("探活失败，档案已保留，但没有激活")
    if args.activate:
        apply_profile(name)
    return 0


def cmd_remove(args) -> int:
    path = profiles().get(args.name)
    if not path:
        die(f"没有档案 {args.name!r}")
    if active_profile() == args.name and not args.force:
        die(f"{args.name} 正在生效；先 `use` 别的档案，或加 --force")
    path.unlink()
    print(f"removed {path}")
    return 0


def cmd_backups(args) -> int:
    if not BACKUP_DIR.is_dir():
        print("（没有备份）")
        return 0
    items = sorted(BACKUP_DIR.glob("settings.json.*"))
    if not items:
        print("（没有备份）")
        return 0
    for p in items[-args.limit :]:
        print(f"  {p.name}  {time.strftime('%Y-%m-%d %H:%M', time.localtime(p.stat().st_mtime))}")
    return 0


def cmd_revert(args) -> int:
    if args.backup:
        src = Path(args.backup).expanduser()
        if not src.exists():
            src = BACKUP_DIR / args.backup
        if not src.exists():
            die(f"找不到备份 {args.backup}")
    else:
        items = sorted(BACKUP_DIR.glob("settings.json.*")) if BACKUP_DIR.is_dir() else []
        if not items:
            die("没有可回滚的备份")
        src = items[-1]
    cur = active_profile()
    backup_settings()
    shutil.copy2(src, SETTINGS)
    print(f"restored {src.name} -> {SETTINGS}")
    if cur:
        print(f"(该备份可能属于别的档案；当前生效: {active_profile() or '未托管'})")
    return 0


# ----------------------------------------------------------------------- main
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="patch-claude-code",
        description="管理 Claude Code 的 provider 补丁（env + model + modelPicker）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("list", help="列出档案")
    s.set_defaults(func=cmd_list)
    s = sub.add_parser("current", help="当前生效档案")
    s.set_defaults(func=cmd_current)
    s = sub.add_parser("backups", help="列出备份")
    s.add_argument("--limit", type=int, default=10)
    s.set_defaults(func=cmd_backups)

    s = sub.add_parser("use", help="切换档案")
    s.add_argument("name")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_use)
    s = sub.add_parser("apply", help="同 use")
    s.add_argument("name")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_use)

    s = sub.add_parser("repair", help="按当前档案重打补丁")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_repair)

    s = sub.add_parser("unpatch", help="移除补丁（回到官方端点）")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_unpatch)

    s = sub.add_parser("show", help="打印档案（key 打码）")
    s.add_argument("name")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("verify", help="探活（真发一次 /v1/messages）")
    s.add_argument("name", nargs="?")
    s.add_argument("--model")
    s.set_defaults(func=cmd_verify)

    s = sub.add_parser("models", help="从网关发现模型")
    s.add_argument("name")
    s.add_argument("--apply", action="store_true", help="写回 modelPicker")
    s.set_defaults(func=cmd_models)

    s = sub.add_parser("revert", help="回滚备份")
    s.add_argument("--backup")
    s.set_defaults(func=cmd_revert)

    s = sub.add_parser("remove", help="删除档案")
    s.add_argument("name")
    s.add_argument("--force", action="store_true")
    s.set_defaults(func=cmd_remove)

    s = sub.add_parser("presets", help="列出内置网关预设")
    s.set_defaults(func=cmd_presets)

    s = sub.add_parser("setup", help="一键：建档案 + 激活 + 探活")
    s.add_argument("--preset", help="预置网关名（见 `presets`）")
    s.add_argument("--name", help="档案名（默认同 preset）")
    s.add_argument("--key", help="直接给 key（不推荐，会落盘）")
    s.add_argument("--key-var", help="key 所在变量名（默认用预设里的）")
    s.add_argument("--discover", action="store_true", help="从网关拉模型列表生成 picker")
    s.add_argument("--keep-builtin", action="store_true", help="保留内置 Opus/Sonnet/Haiku 行")
    s.add_argument("--no-activate", action="store_true", help="只建档案，不写入 settings.json")
    s.add_argument("--no-verify", action="store_true", help="跳过探活")
    s.add_argument("--force", action="store_true", help="覆盖同名档案 / 忽略 claude 未安装")
    s.set_defaults(func=cmd_setup)

    s = sub.add_parser("link", help="把自己链到 PATH 目录")
    s.add_argument("--dir", default=str(Path.home() / ".local" / "bin"))
    s.add_argument("--force", action="store_true")
    s.set_defaults(func=cmd_link)

    s = sub.add_parser("add", help="新建 provider 档案")
    s.add_argument("name")
    s.add_argument("--base-url", required=True, help="Anthropic 协议端点，如 https://api.deepseek.com/anthropic")
    s.add_argument("--auth-var", help="从 ~/.zshrc 读的变量名（推荐）")
    s.add_argument("--auth-env", help="从当前进程环境变量读")
    s.add_argument("--auth-token", help="直接给明文 key（不推荐）")
    s.add_argument("--label")
    s.add_argument("--opus")
    s.add_argument("--sonnet")
    s.add_argument("--haiku")
    s.add_argument("--model", default="sonnet", help="settings.model 默认别名（sonnet/opus/default）")
    s.add_argument("--max-context", type=int, default=1_000_000)
    s.add_argument("--picker", action="append", metavar="ID[:LABEL[:DESC]]")
    s.add_argument("--discover", action="store_true", help="自动发现模型并生成 picker 行")
    s.add_argument("--keep-builtin", action="store_true", help="保留内置 Opus/Sonnet/Haiku 行")
    s.add_argument("--allow-betas", action="store_true", help="不设 CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS")
    s.add_argument("--verify", action="store_true", help="创建后立即探活")
    s.add_argument("--activate", action="store_true", help="创建后立即生效")
    s.add_argument("--force", action="store_true", help="覆盖同名档案")
    s.set_defaults(func=cmd_add)
    return p


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    # 兼容旧用法: patch-claude-code <profile>  ==  use <profile>
    known = {"list", "current", "backups", "use", "apply", "repair", "show", "unpatch",
             "verify", "models", "revert", "remove", "add", "presets", "setup", "link",
             "-h", "--help"}
    if argv and argv[0] not in known and argv[0] in profiles():
        argv = ["use", *argv]
    args = parser.parse_args(argv)
    if not args.cmd:
        parser.print_help()
        cur = active_profile()
        print(f"\n当前生效: {cur or '未托管'}")
        return 0
    return args.func(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
