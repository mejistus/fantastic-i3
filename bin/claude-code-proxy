#!/usr/bin/env python3
"""claude-code-proxy — 让 Claude Code（Anthropic 协议）用上只有 OpenAI 协议的模型。

Claude Code 只会说 Anthropic 的 /v1/messages。有些免费/便宜的模型只在 OpenAI
兼容端点上提供（例如 OpenCode Go 套餐里的 beam-free），这时中间加一层转换：

    Claude Code ──Anthropic──▶ 本代理 ──OpenAI──▶ 上游网关

支持：流式、工具调用（tool_use/tool_result）、system、图片（base64/url）、
count_tokens 估算。只依赖 Python 标准库。

用法:
    claude-code-proxy --upstream https://opencode.ai/inference/go/openai/v1 \\
        --upstream-key-env OPENCODE_GO_APIKEY --port 8787

    # 然后给 Claude Code 建一个指向本机的档案：
    patch-claude-code add opencode-free-openai \\
        --base-url http://127.0.0.1:8787 \\
        --auth-token local-proxy \\
        --opus beam-free --sonnet beam-free --haiku beam-free \\
        --picker "beam-free:Beam Free:free · 1M ctx"

    # 测试
    claude-code-proxy --upstream ... --selftest
"""
from __future__ import annotations

import argparse
import http.server
import json
import os
import re
import socket
import socketserver
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid

VERSION = "1.0"
MAX_BODY = 64 * 1024 * 1024


# ------------------------------------------------------------------ utilities
def zshrc_var(name: str) -> "str | None":
    """和 patch-claude-code 一样：环境变量没有就问 ~/.zshrc。"""
    if not name:
        return None
    from pathlib import Path as _Path

    rc = _Path.home() / ".zshrc"
    if not rc.exists():
        return None
    text = rc.read_text(encoding="utf-8", errors="replace")
    match = re.search(
        r"^[ \t]*(?:export[ \t]+)?" + re.escape(name) + r"[ \t]*=[ \t]*(['\"]?)([^'\"\n#]+)\1",
        text,
        re.M,
    )
    return match.group(2).strip() if match else None


def log(verbose: bool, msg: str) -> None:
    if verbose:
        print(f"[proxy] {msg}", file=sys.stderr, flush=True)


def a_text(content) -> str:
    """Anthropic 的 system/text 内容 → 纯字符串。"""
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    parts = []
    for block in content:
        if isinstance(block, str):
            parts.append(block)
        elif isinstance(block, dict) and block.get("type") == "text":
            parts.append(block.get("text", ""))
    return "\n".join(parts)


def flatten_tool_result(content) -> str:
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    out = []
    for block in content:
        if isinstance(block, str):
            out.append(block)
        elif block.get("type") == "text":
            out.append(block.get("text", ""))
        elif block.get("type") == "image":
            out.append("[image omitted]")
        else:
            out.append(json.dumps(block, ensure_ascii=False))
    return "\n".join(out)


def to_openai_image(block: dict) -> "dict | None":
    src = block.get("source") or {}
    if src.get("type") == "base64":
        return {
            "type": "image_url",
            "image_url": {
                "url": f"data:{src.get('media_type', 'image/png')};base64,{src.get('data', '')}"
            },
        }
    if src.get("type") == "url" and src.get("url"):
        return {"type": "image_url", "image_url": {"url": src["url"]}}
    return None


def openai_tools(tools) -> "list | None":
    if not tools:
        return None
    out = []
    for tool in tools:
        if not isinstance(tool, dict) or "name" not in tool:
            continue
        out.append(
            {
                "type": "function",
                "function": {
                    "name": tool["name"],
                    "description": tool.get("description", ""),
                    "parameters": tool.get("input_schema") or {"type": "object", "properties": {}},
                },
            }
        )
    return out or None


def openai_tool_choice(choice):
    if not choice:
        return None
    kind = choice.get("type")
    if kind == "auto":
        return "auto"
    if kind == "any":
        return "required"
    if kind == "none":
        return "none"
    if kind == "tool" and choice.get("name"):
        return {"type": "function", "function": {"name": choice["name"]}}
    return None


def build_openai_request(req: dict, model_override: "str | None" = None, stream: bool = True) -> dict:
    messages = []
    system = a_text(req.get("system"))
    if system:
        messages.append({"role": "system", "content": system})

    for msg in req.get("messages") or []:
        role = msg.get("role")
        content = msg.get("content")
        if isinstance(content, str):
            messages.append({"role": role, "content": content})
            continue
        blocks = content or []

        if role == "assistant":
            text, calls = [], []
            for block in blocks:
                btype = block.get("type")
                if btype == "text":
                    text.append(block.get("text", ""))
                elif btype == "tool_use":
                    calls.append(
                        {
                            "id": block.get("id") or f"call_{uuid.uuid4().hex[:12]}",
                            "type": "function",
                            "function": {
                                "name": block.get("name", ""),
                                "arguments": json.dumps(block.get("input") or {}, ensure_ascii=False),
                            },
                        }
                    )
            out = {"role": "assistant", "content": "\n".join(t for t in text if t) or None}
            if calls:
                out["tool_calls"] = calls
            if out["content"] is None and not calls:
                continue
            messages.append(out)
            continue

        # user: 工具结果必须先以 tool 消息出现在前面
        parts, tool_results = [], []
        for block in blocks:
            btype = block.get("type")
            if btype == "text":
                parts.append({"type": "text", "text": block.get("text", "")})
            elif btype == "image":
                image = to_openai_image(block)
                if image:
                    parts.append(image)
            elif btype == "tool_result":
                tool_results.append(block)
        for result in tool_results:
            messages.append(
                {
                    "role": "tool",
                    "tool_call_id": result.get("tool_use_id", ""),
                    "content": flatten_tool_result(result.get("content")),
                }
            )
        if parts:
            if len(parts) == 1 and parts[0].get("type") == "text":
                messages.append({"role": "user", "content": parts[0]["text"]})
            else:
                messages.append({"role": "user", "content": parts})

    payload = {
        "model": model_override or req.get("model"),
        "messages": messages,
        "stream": stream,
    }
    if req.get("max_tokens"):
        payload["max_tokens"] = int(req["max_tokens"])
    for key in ("temperature", "top_p"):
        if req.get(key) is not None:
            payload[key] = req[key]
    if req.get("stop_sequences"):
        payload["stop"] = req["stop_sequences"]
    tools = openai_tools(req.get("tools"))
    if tools:
        payload["tools"] = tools
        choice = openai_tool_choice(req.get("tool_choice"))
        if choice:
            payload["tool_choice"] = choice
    if stream:
        payload["stream_options"] = {"include_usage": True}
    return payload


STOP_MAP = {
    "stop": "end_turn",
    "length": "max_tokens",
    "tool_calls": "tool_use",
    "function_call": "tool_use",
    "content_filter": "end_turn",
}


def tool_input(arguments: str) -> dict:
    if not arguments:
        return {}
    try:
        parsed = json.loads(arguments)
        return parsed if isinstance(parsed, dict) else {"value": parsed}
    except json.JSONDecodeError:
        return {"raw": arguments}


def to_anthropic_response(oa: dict, model: str) -> dict:
    choice = (oa.get("choices") or [{}])[0]
    message = choice.get("message") or {}
    content = []
    text = message.get("content")
    if isinstance(text, list):                      # 少数网关返回分片
        text = "".join(part.get("text", "") for part in text if isinstance(part, dict))
    if text:
        content.append({"type": "text", "text": text})
    for call in message.get("tool_calls") or []:
        fn = call.get("function") or {}
        content.append(
            {
                "type": "tool_use",
                "id": call.get("id") or f"toolu_{uuid.uuid4().hex[:16]}",
                "name": fn.get("name", ""),
                "input": tool_input(fn.get("arguments", "")),
            }
        )
    if not content:
        content.append({"type": "text", "text": ""})

    usage = oa.get("usage") or {}
    return {
        "id": f"msg_{uuid.uuid4().hex[:24]}",
        "type": "message",
        "role": "assistant",
        "model": model,
        "content": content,
        "stop_reason": STOP_MAP.get(choice.get("finish_reason") or "stop", "end_turn"),
        "stop_sequence": None,
        "usage": {
            "input_tokens": int(usage.get("prompt_tokens") or 0),
            "output_tokens": int(usage.get("completion_tokens") or 0),
        },
    }


def sse(event: str, payload: dict) -> bytes:
    return f"event: {event}\ndata: {json.dumps(payload, ensure_ascii=False)}\n\n".encode()


def stream_anthropic(upstream, model: str, verbose: bool):
    """把 OpenAI 的 SSE 流翻译成 Anthropic 事件流（生成器，逐条 yield bytes）。"""
    message_id = f"msg_{uuid.uuid4().hex[:24]}"
    yield sse(
        "message_start",
        {
            "type": "message_start",
            "message": {
                "id": message_id,
                "type": "message",
                "role": "assistant",
                "model": model,
                "content": [],
                "stop_reason": None,
                "stop_sequence": None,
                "usage": {"input_tokens": 0, "output_tokens": 0},
            },
        },
    )

    next_index = 0
    text_index = None
    tools: "dict[int, dict]" = {}
    stop_reason = "end_turn"
    usage = {"input_tokens": 0, "output_tokens": 0}

    def close_text():
        nonlocal text_index
        if text_index is not None:
            events = sse(
                "content_block_stop", {"type": "content_block_stop", "index": text_index}
            )
            text_index = None
            return events
        return b""

    for raw in upstream:
        line = raw.decode("utf-8", "replace").strip()
        if not line or line.startswith(":"):
            continue
        if not line.startswith("data:"):
            continue
        data = line[5:].strip()
        if data == "[DONE]":
            break
        try:
            chunk = json.loads(data)
        except json.JSONDecodeError:
            continue

        if chunk.get("usage"):
            usage["input_tokens"] = int(chunk["usage"].get("prompt_tokens") or usage["input_tokens"])
            usage["output_tokens"] = int(
                chunk["usage"].get("completion_tokens") or usage["output_tokens"]
            )

        for choice in chunk.get("choices") or []:
            delta = choice.get("delta") or {}
            if choice.get("finish_reason"):
                stop_reason = STOP_MAP.get(choice["finish_reason"], "end_turn")

            piece = delta.get("content")
            if piece:
                if text_index is None:
                    text_index = next_index
                    next_index += 1
                    yield sse(
                        "content_block_start",
                        {
                            "type": "content_block_start",
                            "index": text_index,
                            "content_block": {"type": "text", "text": ""},
                        },
                    )
                yield sse(
                    "content_block_delta",
                    {
                        "type": "content_block_delta",
                        "index": text_index,
                        "delta": {"type": "text_delta", "text": piece},
                    },
                )

            for call in delta.get("tool_calls") or []:
                slot = call.get("index", 0)
                state = tools.get(slot)
                fn = call.get("function") or {}
                if state is None:
                    if not fn.get("name"):
                        continue
                    flush = close_text()
                    if flush:
                        yield flush
                    state = {
                        "index": next_index,
                        "id": call.get("id") or f"toolu_{uuid.uuid4().hex[:16]}",
                        "name": fn.get("name", ""),
                        "started": True,
                    }
                    tools[slot] = state
                    next_index += 1
                    yield sse(
                        "content_block_start",
                        {
                            "type": "content_block_start",
                            "index": state["index"],
                            "content_block": {
                                "type": "tool_use",
                                "id": state["id"],
                                "name": state["name"],
                                "input": {},
                            },
                        },
                    )
                args_piece = fn.get("arguments")
                if args_piece:
                    yield sse(
                        "content_block_delta",
                        {
                            "type": "content_block_delta",
                            "index": state["index"],
                            "delta": {"type": "input_json_delta", "partial_json": args_piece},
                        },
                    )

    flush = close_text()
    if flush:
        yield flush
    for state in tools.values():
        yield sse(
            "content_block_stop", {"type": "content_block_stop", "index": state["index"]}
        )

    yield sse(
        "message_delta",
        {
            "type": "message_delta",
            "delta": {"stop_reason": stop_reason, "stop_sequence": None},
            "usage": {"input_tokens": usage["input_tokens"], "output_tokens": usage["output_tokens"]},
        },
    )
    yield sse("message_stop", {"type": "message_stop"})


# --------------------------------------------------------------------- server
class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = f"claude-code-proxy/{VERSION}"

    # 由 main() 注入
    opts = None

    def log_message(self, fmt, *args):  # 静音默认访问日志
        log(self.opts.verbose, "http " + (fmt % args))

    # ---------------------------------------------------------------- helpers
    def _json(self, status: int, payload: dict) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _error(self, status: int, kind: str, message: str) -> None:
        self._json(status, {"type": "error", "error": {"type": kind, "message": message}})

    def _authorized(self) -> bool:
        token = self.opts.token
        if not token:
            return True
        supplied = self.headers.get("authorization", "")
        if supplied.lower().startswith("bearer "):
            supplied = supplied[7:].strip()
        if not supplied:
            supplied = self.headers.get("x-api-key", "").strip()
        return supplied == token

    def _upstream_headers(self) -> dict:
        headers = {
            "authorization": f"Bearer {self.opts.upstream_key}",
            "content-type": "application/json",
            "accept": "text/event-stream",
            "user-agent": f"claude-code-proxy/{VERSION}",
        }
        if "opencode" in self.opts.upstream:
            headers["x-opencode-session"] = str(uuid.uuid4())
        for extra in self.opts.upstream_header or []:
            if ":" in extra:
                name, value = extra.split(":", 1)
                headers[name.strip().lower()] = value.strip()
        return headers

    # -------------------------------------------------------------- endpoints
    def do_GET(self):
        path = self.path.split("?")[0]
        if path in ("/health", "/"):
            self._json(200, {"ok": True, "upstream": self.opts.upstream, "version": VERSION})
        elif path.rstrip("/").endswith("/v1/models"):
            self._json(
                200,
                {
                    "data": [
                        {"id": m, "display_name": m, "type": "model", "object": "model"}
                        for m in self.opts.models
                    ],
                    "has_more": False,
                },
            )
        else:
            self._error(404, "not_found_error", f"unknown path {path}")

    def do_POST(self):
        path = self.path.split("?")[0].rstrip("/")
        if not self._authorized():
            self._error(401, "authentication_error", "bad proxy token")
            return
        try:
            length = int(self.headers.get("content-length") or 0)
        except ValueError:
            length = 0
        if length <= 0 or length > MAX_BODY:
            self._error(400, "invalid_request_error", "bad content-length")
            return
        try:
            req = json.loads(self.rfile.read(length))
        except json.JSONDecodeError as exc:
            self._error(400, "invalid_request_error", f"bad json: {exc}")
            return

        if path.endswith("/messages/count_tokens"):
            text = json.dumps(req, ensure_ascii=False)
            self._json(200, {"input_tokens": max(1, len(text) // 4)})
            return
        if not path.endswith("/messages"):
            self._error(404, "not_found_error", f"unknown path {path}")
            return

        stream = bool(req.get("stream"))
        payload = build_openai_request(req, self.opts.model, stream=stream)
        started = time.time()
        try:
            upstream = self._open_upstream(payload)
        except urllib.error.HTTPError as exc:
            body = exc.read().decode("utf-8", "replace")
            log(self.opts.verbose, f"upstream {exc.code}: {body[:200]}")
            try:
                parsed = json.loads(body)
                message = (parsed.get("error") or {}).get("message") if isinstance(parsed.get("error"), dict) else None
                message = message or parsed.get("message") or body[:300]
            except json.JSONDecodeError:
                message = body[:300]
            self._error(exc.code, "api_error", message)
            return
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            self._error(502, "api_error", f"upstream unreachable: {exc}")
            return

        try:
            if stream:
                self.send_response(200)
                self.send_header("content-type", "text/event-stream")
                self.send_header("cache-control", "no-cache")
                self.send_header("connection", "close")
                self.end_headers()
                self.close_connection = True
                for chunk in stream_anthropic(upstream, payload["model"], self.opts.verbose):
                    self.wfile.write(chunk)
                    self.wfile.flush()
            else:
                raw = upstream.read()
                oa = json.loads(raw)
                result = to_anthropic_response(oa, payload["model"])
                self._json(200, result)
            log(
                self.opts.verbose,
                f"{'stream' if stream else 'json'} {payload['model']} done in {time.time() - started:.2f}s",
            )
        except (BrokenPipeError, ConnectionResetError):
            log(self.opts.verbose, "client disconnected")
        finally:
            try:
                upstream.close()
            except Exception:
                pass

    def _open_upstream(self, payload: dict):
        url = self.opts.upstream.rstrip("/") + "/chat/completions"
        data = json.dumps(payload, ensure_ascii=False).encode()
        request = urllib.request.Request(
            url, data=data, headers=self._upstream_headers(), method="POST"
        )
        return urllib.request.urlopen(request, timeout=self.opts.timeout)


class ThreadedServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


# ------------------------------------------------------------------------ cli
def selftest(opts) -> int:
    """不启服务，直接打一次上游，确认 key / 模型 / 协议都对。"""
    payload = build_openai_request(
        {
            "model": opts.model,
            "max_tokens": 64,
            "messages": [{"role": "user", "content": "用一句话说明你是谁"}],
        },
        stream=False,
    )
    url = opts.upstream.rstrip("/") + "/chat/completions"
    headers = {
        "authorization": f"Bearer {opts.upstream_key}",
        "content-type": "application/json",
        "user-agent": f"claude-code-proxy/{VERSION}",
    }
    if "opencode" in opts.upstream:
        headers["x-opencode-session"] = str(uuid.uuid4())
    request = urllib.request.Request(
        url, data=json.dumps(payload).encode(), headers=headers, method="POST"
    )
    print(f"upstream : {url}")
    print(f"model    : {opts.model}")
    try:
        with urllib.request.urlopen(request, timeout=opts.timeout) as resp:
            doc = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        print(f"status   : {exc.code} FAIL")
        print(f"body     : {exc.read().decode('utf-8', 'replace')[:300]}")
        return 1
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        print(f"status   : unreachable ({exc})")
        return 1
    message = (doc.get("choices") or [{}])[0].get("message") or {}
    print(f"status   : 200 OK")
    print(f"reply    : {(message.get('content') or '').strip()[:200] or '(empty, reasoning only)'}")
    usage = doc.get("usage") or {}
    print(f"usage    : {usage.get('prompt_tokens')} in / {usage.get('completion_tokens')} out"
          f"  cost={usage.get('cost')}")
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog="claude-code-proxy",
        description="Anthropic /v1/messages → OpenAI /chat/completions 转换代理，给 Claude Code 用",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument("--upstream", required=True, help="OpenAI 兼容的 base url，例如 https://opencode.ai/inference/go/openai/v1")
    parser.add_argument("--upstream-key", help="上游 key（明文；不推荐）")
    parser.add_argument("--upstream-key-env", help="从环境变量读上游 key")
    parser.add_argument("--upstream-header", action="append", metavar="NAME:VALUE", help="额外上游请求头，可重复")
    parser.add_argument("--model", help="强制使用某个上游模型 id（忽略 Claude Code 传来的）")
    parser.add_argument("--models", default="", help="/v1/models 要列出的模型，逗号分隔")
    parser.add_argument("--port", type=int, default=8787)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--token", help="要求 Claude Code 带上这个 bearer token（默认不校验）")
    parser.add_argument("--timeout", type=float, default=300.0)
    parser.add_argument("--verbose", "-v", action="store_true")
    parser.add_argument("--selftest", action="store_true", help="只打一次上游然后退出")
    opts = parser.parse_args(argv)

    if not opts.upstream_key and opts.upstream_key_env:
        opts.upstream_key = os.environ.get(opts.upstream_key_env) or zshrc_var(
            opts.upstream_key_env
        )
    if not opts.upstream_key:
        parser.error(
            "需要 --upstream-key，或 --upstream-key-env 指向一个有值的变量（当前环境或 ~/.zshrc）"
        )
    if not opts.upstream:
        parser.error("需要 --upstream")
    if not opts.models:
        opts.models = opts.model or "beam-free"
    opts.model_list = [m.strip() for m in opts.models.split(",") if m.strip()]
    opts.models = opts.model_list

    if opts.selftest:
        return selftest(opts)

    Handler.opts = opts
    server = ThreadedServer((opts.host, opts.port), Handler)
    print(f"claude-code-proxy {VERSION} listening on http://{opts.host}:{opts.port}")
    print(f"upstream : {opts.upstream}")
    print(f"model    : {opts.model or '(pass-through)'}")
    if opts.token:
        print(f"token    : required ({opts.token[:4]}…)")
    print("Claude Code 侧：--base-url http://%s:%d --auth-token %s" % (opts.host, opts.port, opts.token or "任意值"))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
